{
  "schema_version": 1,
  "target": "godot",
  "project_name": "Captain Salvage",
  "project_directory": "../../Godot",
  "output_directory": "../../Saved/AutomationTestResults",
  "godot": { "executable": "%GODOT_BIN%" },
  "automation_arguments": ["--headless"],
  "suites": [
    {
      "id": "runtime",
      "description": "GDScript SSOT: 조립·연결 분리·탄약·방어막 규칙",
      "script": "res://tests/test_runner.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] godot-runtime"]
    },
    {
      "id": "physics",
      "description": "Godot 2D: 실제 추력·웹 기준 지수 감쇠 스모크 테스트",
      "script": "res://tests/physics_smoke.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] physics-smoke"]
    },
    {
      "id": "narrative",
      "description": "퀘스트·튜토리얼·이벤트·선택형 대화 큐",
      "script": "res://tests/narrative_test.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] narrative-system"]
    },
    {
      "id": "npc-ai",
      "description": "NPC 로밍·선제공격·피격 반격·대화 상태 전환",
      "script": "res://tests/npc_ai_test.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] npc-ai"]
    },
    {
      "id": "grapple",
      "description": "갈고리 비행·물리 체인·충돌 비활성 스모크 테스트",
      "script": "res://tests/grapple_smoke.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] grapple-smoke"]
    },
    {
      "id": "target-navigation",
      "description": "적 표적 지정·자동 조준·빈 공간 자동 항법",
      "script": "res://tests/target_navigation_smoke.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] target-navigation-smoke"]
    },
    {
      "id": "developer-mode",
      "description": "개발자 편집 모드 선택 메뉴와 테스트 파일럿 진입",
      "script": "res://tests/developer_mode_test.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] developer-mode"]
    }
  ],
  "manual_rhi": {
    "description": "Visible Godot renderer test",
    "scene": "res://Main.tscn",
    "rhi_modes": [
      {"id":"d3d12", "description":"Direct3D 12", "arguments":["--rendering-driver", "d3d12"]},
      {"id":"vulkan", "description":"Vulkan", "arguments":["--rendering-driver", "vulkan"]},
      {"id":"opengl3", "description":"OpenGL 3 Compatibility", "arguments":["--rendering-driver", "opengl3"]}
    ],
    "arguments": ["--debug"],
    "wait": false
  }
}
