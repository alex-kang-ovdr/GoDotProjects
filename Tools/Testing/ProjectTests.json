{
  "schema_version": 1,
  "target": "godot",
  "project_name": "Captain Salvage",
  "project_directory": "../../Godot",
  "output_directory": "../../Saved/AutomationTestResults",
  "godot": { "executable": "%GODOT_BIN%" },
  "automation_arguments": ["--headless"],
  "suites": [
    {
      "id": "runtime",
      "description": "GDScript SSOT: 조립·연결 분리·탄약·방어막 규칙",
      "script": "res://tests/test_runner.gd",
      "timeout_seconds": 120,
      "success_patterns": ["[PASS] godot-runtime"]
    }
  ],
  "manual_rhi": {
    "description": "Visible Godot renderer test",
    "scene": "res://Main.tscn",
    "rhi_modes": [
      {"id":"d3d12", "description":"Direct3D 12", "arguments":["--rendering-driver", "d3d12"]},
      {"id":"vulkan", "description":"Vulkan", "arguments":["--rendering-driver", "vulkan"]},
      {"id":"opengl3", "description":"OpenGL 3 Compatibility", "arguments":["--rendering-driver", "opengl3"]}
    ],
    "arguments": ["--debug"],
    "wait": false
  }
}
