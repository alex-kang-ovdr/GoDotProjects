{
  "name": "playhub-iis-poc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local IIS web game platform PoC with separate player and administrator sites",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "build": "node tools/build.mjs",
    "start": "node server/index.mjs --config config/local.json",
    "dev": "node tools/dev.mjs --config config/local.json",
    "test": "node --test tests/*.mjs",
    "check": "node tools/verify.mjs",
    "check:stack": "node tools/check-stack.mjs",
    "smoke": "node tools/smoke.mjs",
    "check:all": "node tools/acceptance.mjs"
  },
  "playhubDatabaseSchemaVersion": 1
}
