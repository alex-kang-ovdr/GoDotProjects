{
  "name": "ironwood-foundry",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "JavaScript physics construction game inspired by Besiege",
  "dependencies": {
    "three": "0.180.0",
    "cannon-es": "0.20.0"
  },
  "scripts": {
    "start": "python3 -m http.server 8080 --directory dist",
    "test": "node --test tests/*.test.mjs",
    "pack:source": "python3 scripts/package_source.py",
    "build:offline": "node scripts/build_offline.mjs",
    "verify:cpu": "node --experimental-vm-modules scripts/check_ui_cpu.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.5"
  }
}
