    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    
    <Item class="Script" referent="RBXCHAOS00000043">
      <Properties>
        <string name="Name">Motion</string>
        <ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")

local Rotations = game.Workspace:WaitForChild('Rotation')

local Right = Rotations:WaitForChild('Right')
local Left = Rotations:WaitForChild('Left')
local CylRight = Rotations:WaitForChild('CylRight')
local CylLeft = Rotations:WaitForChild('CylLeft')

local Right60 = Right:WaitForChild('Right60')
local Left60 = Left:WaitForChild('Left60')
local Right480 = Right:WaitForChild('Right480')
local Left480 = Left:WaitForChild('Left480')
local CylRight30 = CylRight:WaitForChild('CylRight30')
local CylLeft30 = CylLeft:WaitForChild('CylLeft30')

local RotationSpeed = math.rad(60)

RunService.Heartbeat:Connect(function(dt)
	local AngleChange = RotationSpeed * dt
	for _, part in Right60:GetChildren() do
		if part:IsA("BasePart") then
			part.AssemblyAngularVelocity = Vector3.new(0, RotationSpeed, 0)
			part.CFrame = part.CFrame * CFrame.Angles(0, AngleChange, 0)
		end
	end
	for _, part in Left60:GetChildren() do
		if part:IsA("BasePart") then
			part.AssemblyAngularVelocity = Vector3.new(0, -RotationSpeed, 0)
			part.CFrame = part.CFrame * CFrame.Angles(0, -AngleChange, 0)
		end
	end
	for _, part in Right480:GetChildren() do
		if part:IsA("BasePart") then
			part.AssemblyAngularVelocity = Vector3.new(0, RotationSpeed*8, 0)
			part.CFrame = part.CFrame * CFrame.Angles(0, AngleChange*8, 0)
		end
	end
	for _, part in Left480:GetChildren() do
		if part:IsA("BasePart") then
			part.AssemblyAngularVelocity = Vector3.new(0, -RotationSpeed*8, 0)
			part.CFrame = part.CFrame * CFrame.Angles(0, -AngleChange*8, 0)
		end
	end
	for _, part in CylRight30:GetChildren() do
		if part:IsA("BasePart") then
			part.AssemblyAngularVelocity = part.CFrame:VectorToWorldSpace(Vector3.new(RotationSpeed/2, 0, 0))
			part.CFrame = part.CFrame * CFrame.Angles(AngleChange/2, 0, 0)
		end
	end
	for _, part in CylLeft30:GetChildren() do
		if part:IsA("BasePart") then
		part.AssemblyAngularVelocity = part.CFrame:VectorToWorldSpace(Vector3.new(-RotationSpeed/2, 0, 0))
			part.CFrame = part.CFrame * CFrame.Angles(-AngleChange/2, 0, 0)
		end
	end
end)]]></ProtectedString>
      </Properties>
    </Item>
    
    <Item class="Script" referent="RBXCHAOS00000044">
      <Properties>
        <string name="Name">Checkpoints</string>
        <ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local DataStore = DataStoreService:GetDataStore("ProgressPoints")

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local checkpointsFolder = Workspace:WaitForChild("Checkpoints")
local lobbySpawn = Workspace:WaitForChild("Spawnpoints"):WaitForChild("LobbySpawn")

local function findSpawnLocation(checkpointObject)
	if checkpointObject:IsA("SpawnLocation") then
		return checkpointObject
	elseif checkpointObject:IsA("Model") then
		return checkpointObject:FindFirstChildOfClass("SpawnLocation", true)
	end
	return nil
end

Players.PlayerAdded:Connect(function(player)
	if lobbySpawn:IsA("SpawnLocation") then
		player.RespawnLocation = lobbySpawn
	end

	local stageValue = Instance.new("StringValue")
	stageValue.Name = "Stage"
	stageValue.Parent = player

	local key = "Player_" .. player.UserId
	local success, savedStageName = pcall(function()
		return DataStore:GetAsync(key)
	end)

	if success and savedStageName then
		stageValue.Value = savedStageName
	else
		stageValue.Value = "Red 0"
	end
end)

local function setupCheckpointTouch(part, checkpointObject)
	if part:IsA("BasePart") then
		part.Touched:Connect(function(otherPart)
			local character = otherPart:FindFirstAncestorOfClass("Model")
			if not character then return end

			local player = Players:GetPlayerFromCharacter(character)
			if not player then return end

			local spawnLoc = findSpawnLocation(checkpointObject)
			if spawnLoc then
				player.RespawnLocation = spawnLoc
			end

			local stage = player:FindFirstChild("Stage")
			if stage and stage.Value ~= checkpointObject.Name then
				stage.Value = checkpointObject.Name

				local key = "Player_" .. player.UserId
				pcall(function()
					DataStore:SetAsync(key, checkpointObject.Name)
				end)
			end
		end)
	end
end

local function setupCheckpoint(checkpointObject)
	if checkpointObject:IsA("BasePart") then
		setupCheckpointTouch(checkpointObject, checkpointObject)
	elseif checkpointObject:IsA("Model") then
		for _, part in ipairs(checkpointObject:GetDescendants()) do
			setupCheckpointTouch(part, checkpointObject)
		end
	end
end

for _, child in ipairs(checkpointsFolder:GetChildren()) do
	setupCheckpoint(child)
end

checkpointsFolder.ChildAdded:Connect(setupCheckpoint)]]></ProtectedString>
      </Properties>
    </Item>
    
    <Item class="Script" referent="RBXCHAOS00000045">
      <Properties>
        <string name="Name">LavaObstacles</string>
        <ProtectedString name="Source"><![CDATA[local lavas = game.Workspace:WaitForChild('Lava'):GetChildren()

for _, lava in lavas do
	lava.Touched:Connect(function(object)
		local Obbyplayer = game.Players:GetPlayerFromCharacter(object.Parent)
		if Obbyplayer then
			object.Parent.Humanoid.Health = 0
		end
	end)
end
]]></ProtectedString>
      </Properties>
    </Item>
    
    <Item class="Script" referent="RBXCHAOS00000046">
      <Properties>
        <string name="Name">Teleport</string>
        <ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local DataStore = DataStoreService:GetDataStore("ProgressPoints")

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local teleportsFolder = Workspace:WaitForChild("Teleports")
local lobbyFolder = teleportsFolder:WaitForChild("Lobby")
local checkpointsFolder = Workspace:WaitForChild("Checkpoints")

local debounce = {}

local function teleportPlayerToSavedCheckpoint(player)
	local character = player.Character
	if not character then return end

	local rootPart = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid then return end

	local key = "Player_" .. player.UserId
	local success, savedSpawnName = pcall(function()
		return DataStore:GetAsync(key)
	end)

	local targetCheckpointName = "Red 0"

	if success and savedSpawnName then
		targetCheckpointName = savedSpawnName
	end

	local targetPart = checkpointsFolder:FindFirstChild(targetCheckpointName)

	if not targetPart then
		targetPart = checkpointsFolder:FindFirstChild("Red 0")
	end

	if targetPart then
		local targetCFrame = targetPart:IsA("Model") and targetPart:GetPivot() or targetPart.CFrame

		rootPart.Anchored = true
		character:PivotTo(targetCFrame + Vector3.new(0, 4, 0))

		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

		task.wait(0.1)
		rootPart.Anchored = false

		player:SetAttribute("LevelRed", true)
	else
		warn("Could not find checkpoint target part: " .. tostring(targetCheckpointName))
	end
end

local function setupTeleportPart(part)
	if part:IsA("BasePart") then
		part.Touched:Connect(function(otherPart)
			local character = otherPart:FindFirstAncestorOfClass("Model")
			if not character then return end

			local player = Players:GetPlayerFromCharacter(character)
			if player and not debounce[player] then
				debounce[player] = true

				teleportPlayerToSavedCheckpoint(player)

				task.wait(1)
				debounce[player] = nil
			end
		end)
	end
end

for _, part in ipairs(lobbyFolder:GetDescendants()) do
	setupTeleportPart(part)
end

lobbyFolder.DescendantAdded:Connect(setupTeleportPart)]]></ProtectedString>
      </Properties>
    </Item>
    
    <Item class="Script" referent="RBXCHAOS00000047">
      <Properties>
        <string name="Name">ChaosFeatures</string>
        <ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function normal(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = 16
	end
	game:GetService("Lighting").FogStart = 100
	game:GetService("Lighting").FogEnd = 500
	game:GetService("Lighting").FogColor = Color3.fromRGB(200, 200, 200)  
	print("normal")
end

local function low_speed(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = 8
		print("low_speed")
	end
end

local function high_speed(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = 64
		print("high_speed")
	end
end

local function darkness(character)
	game:GetService("Lighting").FogStart = 0
	game:GetService("Lighting").FogEnd = 20
	game:GetService("Lighting").FogColor = Color3.fromRGB(50, 50, 50)
	print("darkness")
end

local chaosNames = {
	[low_speed] = "Low Speed",
	[high_speed] = "High Speed",
	[darkness] = "Darkness"
}

local currentChaos = normal

local function applyChaos(player, character)
	if not character then return end
	if player:GetAttribute("LevelRed") == true then
		currentChaos(character)
	else
		normal(character)
	end
end

local function newPlayer(player)
	player.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		applyChaos(player, character)
	end)

	player:GetAttributeChangedSignal("LevelRed"):Connect(function()
		if player.Character then
			applyChaos(player, player.Character)
		end
	end)

	if player.Character then
		applyChaos(player, player.Character)
	end
end

local function timer(seconds, status)
	ReplicatedStorage:SetAttribute("ChaosText", status)
	for i = seconds, 1, -1 do
		ReplicatedStorage:SetAttribute("TimeLeft", i)
		task.wait(1)
	end
end

game.Players.PlayerAdded:Connect(newPlayer)

for _, player in ipairs(game.Players:GetPlayers()) do
	newPlayer(player)
end

while true do
	local functionList = {low_speed, high_speed, darkness}
	local randomGenerator = Random.new()
	local ChaosFunction = functionList[randomGenerator:NextInteger(1, #functionList)]

	timer(240, "Next Chaos Event In:")

	currentChaos = ChaosFunction
	for _, player in ipairs(game.Players:GetPlayers()) do
		local character = player.Character
		if character then
			applyChaos(player, character)
		end
	end

	local eventName = chaosNames[ChaosFunction] or "Chaos Event"
	timer(60, eventName .. " Event Ends In:")

	currentChaos = normal
	for _, player in ipairs(game.Players:GetPlayers()) do
		local character = player.Character
		if character then
			applyChaos(player, character)
		end
	end
end



]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBXCHAOS00000048">
