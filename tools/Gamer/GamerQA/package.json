{
  "name": "playhub-gamerqa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PlayHub GamerQA CLI, policy-driven static/security/runtime-web suites, and reporting.",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "gamerqa": "./bin/gamerqa.mjs"
  },
  "scripts": {
    "check": "node ./bin/gamerqa.mjs verify --check",
    "test": "node --test tests/*.test.mjs",
    "qa": "node ./bin/gamerqa.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
