{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playforge.internal/schemas/unified-game-ir.v0.1.schema.json",
  "title": "PlayForge Unified Game IR v0.1",
  "description": "Engine-neutral intermediate representation shared across Unreal, Unity, and Roblox to Godot 4.x converters.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "units",
    "scenes",
    "entities",
    "logic",
    "assets",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "source": {
      "type": "object",
      "required": ["engine", "version", "project"],
      "properties": {
        "engine": { "type": "string", "enum": ["unreal", "unity", "roblox"] },
        "version": { "type": "string" },
        "project": { "type": "string" },
        "project_path": { "type": "string" },
        "extracted_at": { "type": "string" }
      }
    },
    "units": {
      "type": "object",
      "required": ["distance", "coordinate_system"],
      "properties": {
        "distance": { "type": "string", "enum": ["meter", "centimeter", "stud"] },
        "coordinate_system": { "type": "string", "enum": ["godot_3d", "unreal_lh_z_up", "unity_lh_y_up"] },
        "scale_factor": { "type": "number" },
        "axis_mapping": { "type": "string" }
      }
    },
    "input_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "godot_action", "bindings"],
        "properties": {
          "action": { "type": "string" },
          "godot_action": { "type": "string" },
          "value_type": { "type": "string", "enum": ["bool", "axis1d", "axis2d", "axis3d"] },
          "bindings": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "entities"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "source_path": { "type": "string" },
          "entities": { "type": "array", "items": { "type": "string" } },
          "environment": { "type": "object" }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "source_class", "transform", "components"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "source_class": { "type": "string" },
          "godot_class": { "type": "string" },
          "parent_id": { "type": ["string", "null"] },
          "transform": {
            "type": "object",
            "required": ["position", "rotation_deg", "scale"],
            "properties": {
              "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "rotation_deg": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "scale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            }
          },
          "components": { "type": "array", "items": { "type": "object" } },
          "logic_refs": { "type": "array", "items": { "type": "string" } },
          "animation_ref": { "type": ["string", "null"] }
        }
      }
    },
    "logic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "nodes", "edges"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["event_graph", "function_graph", "cpp_class", "script"] },
          "source_path": { "type": "string" },
          "target_entity_class": { "type": "string" },
          "variables": { "type": "array", "items": { "type": "object" } },
          "nodes": { "type": "array", "items": { "type": "object" } },
          "edges": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "states", "transitions"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "default_state": { "type": "string" },
          "states": { "type": "array", "items": { "type": "object" } },
          "transitions": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source_path", "license_status", "redistributable"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "source_path": { "type": "string" },
          "sha256": { "type": "string" },
          "license": { "type": "string" },
          "license_status": { "type": "string", "enum": ["allowed", "internal_only", "blocked", "unknown"] },
          "redistributable": { "type": "boolean" },
          "godot_path": { "type": ["string", "null"] }
        }
      }
    },
    "source_map": {
      "type": "array",
      "items": { "type": "object" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "stage", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "stage": { "type": "string" },
          "source_ref": { "type": "string" },
          "message": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
