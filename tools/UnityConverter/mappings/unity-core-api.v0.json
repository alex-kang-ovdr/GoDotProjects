      "target": { "strategy": "adapter", "godot_api": "PhysicsDirectSpaceState2D.intersect_ray / GridOccupancyQuery(blocking_layer)" },
      "transforms": { "coordinate_basis": "unity_2d_y_up_to_godot_y_down", "unit_policy": "collision_layer_bit" },
      "validation": { "fixtures": ["2d_roguelike_blocking_check"] }
    },
    {
      "id": "Collider2D.OnTriggerEnter2D",
      "grade": "D",
      "source": { "class": "MonoBehaviour", "member": "OnTriggerEnter2D(Collider2D)", "kind": "event" },
      "target": { "strategy": "native", "godot_api": "Area2D.area_entered / grid cell trigger check" },
      "transforms": { "coordinate_basis": "none", "unit_policy": "none" },
      "validation": { "fixtures": ["2d_roguelike_pickups_and_exit"] }
    },
    {
      "id": "Object.Instantiate_SetParent",
      "grade": "D",
      "source": { "class": "Object", "member": "Instantiate(prefab, pos, rot) + transform.SetParent", "kind": "factory" },
      "target": { "strategy": "native", "godot_api": "PackedScene.instantiate() + parent.add_child(node)" },
      "transforms": { "coordinate_basis": "unity_2d_y_up_to_godot_y_down", "unit_policy": "pixels_per_unit" },
      "validation": { "fixtures": ["2d_roguelike_board_spawn"] }
    },
    {
      "id": "Object.DontDestroyOnLoad_SceneManager",
      "grade": "R",
      "source": { "class": "SceneManager", "member": "DontDestroyOnLoad + LoadScene + sceneLoaded", "kind": "lifecycle" },
      "target": { "strategy": "runtime", "godot_api": "Autoload Singleton (GameManager, SoundManager) + level_reset/reload" },
      "transforms": { "coordinate_basis": "none", "unit_policy": "none" },
      "validation": { "fixtures": ["2d_roguelike_level_progression"] }
    },
    {
      "id": "AudioSource.RandomizeSfx",
      "grade": "D",
      "source": { "class": "AudioSource", "member": "pitch = Random.Range(0.95, 1.05); Play()", "kind": "audio" },
      "target": { "strategy": "native", "godot_api": "AudioStreamPlayer.pitch_scale = randf_range(0.95, 1.05); play()" },
      "transforms": { "coordinate_basis": "none", "unit_policy": "none" },
      "validation": { "fixtures": ["2d_roguelike_sfx_pitch"] }
    },
    {
      "id": "Input.GetAxisRaw",
      "grade": "D",
      "source": { "class": "Input", "member": "GetAxisRaw('Horizontal'/'Vertical')", "kind": "input" },
      "target": { "strategy": "native", "godot_api": "Input.get_axis('ui_left','ui_right') / Input.is_action_pressed" },
      "transforms": { "coordinate_basis": "unity_2d_y_up_to_godot_y_down", "unit_policy": "input_map" },
      "validation": { "fixtures": ["2d_roguelike_input_move"] }
    },
    {
      "id": "UnityEngine.UI.Text_Canvas",
      "grade": "D",
      "source": { "class": "UnityEngine.UI", "member": "Canvas + Text + Image", "kind": "ui" },
      "target": { "strategy": "native", "godot_api": "CanvasLayer + Control + ColorRect + Label (PressStart2P.ttf)" },
      "transforms": { "coordinate_basis": "anchor_layout", "unit_policy": "pixel" },
      "validation": { "fixtures": ["2d_roguelike_hud_overlay"] }
    },
    {
      "id": "MonoBehaviour.Invoke",
      "grade": "D",
      "source": { "class": "MonoBehaviour", "member": "Invoke('Method', delay)", "kind": "timer" },
      "target": { "strategy": "native", "godot_api": "get_tree().create_timer(delay).timeout" },
      "transforms": { "coordinate_basis": "none", "unit_policy": "seconds" },
      "validation": { "fixtures": ["2d_roguelike_level_transition_delay"] }
    },
    {
      "id": "UnityEditor.ReadmeEditor",
      "grade": "X",
      "source": { "class": "UnityEditor", "member": "Editor / CustomEditor / MenuItem", "kind": "editor_only" },
      "target": { "strategy": "external", "godot_api": "Excluded from runtime port (TutorialInfo/Editor only)" },
      "transforms": { "coordinate_basis": "none", "unit_policy": "none" },
      "validation": { "fixtures": ["2d_roguelike_editor_exclusion"] }
    }
  ]
}
