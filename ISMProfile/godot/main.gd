extends Node3D
## Godot port of the Unreal "InstancedMeshProfile" benchmark.
##   mode "ISM"   -> one MultiMeshInstance3D drawing every block        (UE: single UInstancedStaticMeshComponent)
##   mode "Actor" -> one MeshInstance3D node per block (shared mesh/mat) (UE: one AStaticMeshActor per block)
## Same deterministic layout (generated by tools/gen_assets.py from the UE code), same cube/atlas,
## same ortho camera + sun, same AB/BA ordering, warm-up/measure windows and percentile method.
##
## Run:  Godot --path godot -- --sizes=48,96,144 --modes=ISM,Actor --repeats=2 --warmup=3 --seconds=5 \
##                              --seed=1337 --out=<dir> [--shots] [--no-quit]

const BLOCK_TYPE_MAX := 11
const SUN_YAW_PITCH := Vector2(-30.0, -55.0) # UE FRotator(Pitch=-55, Yaw=-30)

var opt := {
	"sizes": [48, 96, 144], "modes": ["ISM", "Actor"], "repeats": 2, "warmup": 3.0, "seconds": 5.0,
	"seed": 1337, "out": "", "shots": false, "no_quit": false, "sun": 0.9, "ambient": 0.0, "plane": 0.30, "tonemap": "aces",
	"tag": "godot", "preview_size": 0, "preview_mode": "ISM",
}

var cases: Array = []
var case_index := 0
var world: Node3D = null
var cam: Camera3D
var sun: DirectionalLight3D
var env: WorldEnvironment
var box_mesh: BoxMesh
var mat_ism: ShaderMaterial
var mat_actor: ShaderMaterial
var summary_csv := ""
var samples_csv := ""
var layout_hash := 0
var layout_blocks := 0
var generate_ms := 0.0
var build_ms := 0.0
var first_frame_ms := 0.0
var viewport_rid: RID

# per-case sample arrays
var s_frame := PackedFloat64Array()
var s_game := PackedFloat64Array()
var s_render := PackedFloat64Array()
var s_gpu := PackedFloat64Array()
var s_draw := PackedFloat64Array()
var s_prim := PackedFloat64Array()
var s_obj := PackedFloat64Array()
var s_setup := PackedFloat64Array()
var last_tick_us := 0
var phase := "idle"
var phase_start := 0.0
var case_shot_done := false
var shot_wait_until := 0.0
var cur_case := {}
var passed := true


func _ready() -> void:
	_parse_args()
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	get_window().size = Vector2i(1440, 900)
	get_window().mode = Window.MODE_WINDOWED
	viewport_rid = get_viewport().get_viewport_rid()
	RenderingServer.viewport_set_measure_render_time(viewport_rid, true)
	_setup_static_scene()
	if opt.out == "":
		opt.out = ProjectSettings.globalize_path("res://").path_join("../results/godot/%s" % Time.get_datetime_string_from_system().replace(":", "-"))
	DirAccess.make_dir_recursive_absolute(opt.out)
	_build_cases()
	summary_csv = "case,repeat,mode,seed,size,blocks,layout_hash,collision,block_nodes,mesh_nodes,generate_ms,build_submit_ms,first_frame_ms,samples,frame_mean_ms,frame_p50_ms,frame_p95_ms,game_p50_ms,render_p50_ms,gpu_p50_ms,process_memory_mb,draw_calls_p50,primitives_p50,objects_p50,video_mem_mb,static_mem_mb,valid,frame_setup_cpu_p50_ms\n"
	samples_csv = "case,frame,frame_ms,game_ms,render_ms,gpu_ms,draw_calls,primitives,objects\n"
	_write_environment()
	await get_tree().process_frame
	_run()


func _parse_args() -> void:
	for a in OS.get_cmdline_user_args():
		if not a.begins_with("--"):
			continue
		var kv := a.substr(2).split("=", true, 1)
		var k := kv[0]
		var v := kv[1] if kv.size() > 1 else "true"
		match k:
			"sizes": opt.sizes = Array(v.split(",")).map(func(s): return int(s))
			"modes": opt.modes = Array(v.split(","))
			"repeats": opt.repeats = int(v)
			"warmup": opt.warmup = float(v)
			"seconds": opt.seconds = float(v)
			"seed": opt.seed = int(v)
			"out": opt.out = v
			"shots": opt.shots = true
			"no-quit": opt.no_quit = true
			"sun": opt.sun = float(v)
			"ambient": opt.ambient = float(v)
			"plane": opt.plane = float(v)
			"tonemap": opt.tonemap = v
			"tag": opt.tag = v
			"preview-size": opt.preview_size = int(v)
			"preview-mode": opt.preview_mode = v


# ------------------------------------------------------------------ static scene
func _ue_to_godot(v: Vector3) -> Vector3:
	# UE: X fwd, Y right, Z up (left-handed, cm).  Godot: X right, Y up, -Z fwd (right-handed, m).
	return Vector3(v.y, v.z, -v.x)


func _setup_static_scene() -> void:
	cam = Camera3D.new()
	cam.projection = Camera3D.PROJECTION_ORTHOGONAL
	# UE: OrthoWidth=S*210cm ends up spanning the viewport HEIGHT of the 1440x900 window (measured on evidence shots)
	cam.keep_aspect = Camera3D.KEEP_HEIGHT
	cam.near = 0.05
	cam.far = 4000.0
	add_child(cam)
	cam.current = true

	sun = DirectionalLight3D.new()
	sun.light_energy = opt.sun
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 800.0
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL
	add_child(sun)
	var pitch := deg_to_rad(SUN_YAW_PITCH.y)
	var yaw := deg_to_rad(SUN_YAW_PITCH.x)
	var fwd_ue := Vector3(cos(pitch) * cos(yaw), cos(pitch) * sin(yaw), sin(pitch))
	var dir := _ue_to_godot(fwd_ue)
	sun.transform = Transform3D(Basis.looking_at(dir, Vector3.UP), Vector3.ZERO)

	var e := Environment.new()
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color.BLACK
	e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	e.ambient_light_color = Color(1, 1, 1)
	e.ambient_light_energy = opt.ambient
	match opt.tonemap:
		"linear": e.tonemap_mode = Environment.TONE_MAPPER_LINEAR
		"aces": e.tonemap_mode = Environment.TONE_MAPPER_ACES
		"agx": e.tonemap_mode = Environment.TONE_MAPPER_AGX
		_: e.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env = WorldEnvironment.new()
	env.environment = e
	add_child(env)

	box_mesh = BoxMesh.new()
	box_mesh.size = Vector3.ONE
	var side := load("res://assets/atlas_side.png") as Texture2D
	var top := load("res://assets/atlas_top.png") as Texture2D
	mat_ism = _make_material(true, side, top)
	mat_actor = _make_material(false, side, top)


func _make_material(multimesh: bool, side: Texture2D, top: Texture2D) -> ShaderMaterial:
	var code := "shader_type spatial;\nrender_mode diffuse_lambert, specular_disabled;\n"
	code += "uniform sampler2D atlas_side : source_color, filter_nearest, repeat_disable;\n"
	code += "uniform sampler2D atlas_top : source_color, filter_nearest, repeat_disable;\n"
	if not multimesh:
		code += "instance uniform float block_type = 0.0;\n"
	code += "varying flat float v_type;\nvarying float v_top;\n"
	code += "void vertex() {\n"
	code += ("	v_type = INSTANCE_CUSTOM.r;\n" if multimesh else "	v_type = block_type;\n")
	code += "	v_top = clamp((MODEL_MATRIX * vec4(NORMAL, 0.0)).y, 0.0, 1.0);\n}\n"
	code += """void fragment() {
	float sel = clamp(floor(v_type + 0.5), 0.0, 11.0);
	vec2 tile = vec2(mod(sel, 4.0), floor(sel / 4.0));
	vec2 pix = clamp(UV * 16.0, vec2(0.5), vec2(15.5));
	vec2 uv = (tile * 16.0 + pix) / 64.0;
	vec3 base = mix(texture(atlas_side, uv).rgb, texture(atlas_top, uv).rgb, v_top);
	ALBEDO = base;
	EMISSION = base * 0.14;
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
}
"""
	var sh := Shader.new()
	sh.code = code
	var m := ShaderMaterial.new()
	m.shader = sh
	m.set_shader_parameter("atlas_side", side)
	m.set_shader_parameter("atlas_top", top)
	return m


# ------------------------------------------------------------------ cases
func _build_cases() -> void:
	cases.clear()
	var modes: Array = opt.modes
	for size in opt.sizes:
		for r in range(opt.repeats):
			for m in range(modes.size()):
				cases.append({"size": size, "mode": modes[(m + r) % modes.size()], "repeat": r})


func _run() -> void:
	if opt.preview_size > 0:
		cur_case = {"size": opt.preview_size, "mode": opt.preview_mode, "repeat": 0}
		await _begin_case()
		await get_tree().create_timer(1.5).timeout
		_save_shot(opt.out.path_join("preview-%s-size%d.png" % [opt.preview_mode, opt.preview_size]))
		if not opt.no_quit:
			get_tree().quit(0)
		return
	case_index = 0
	while case_index < cases.size():
		cur_case = cases[case_index]
		var ok: bool = await _begin_case()
		if not ok:
			passed = false
			break
		await _warmup_and_measure()
		await _finish_case()
		case_index += 1
	_finish_suite()


func _clear_world() -> void:
	if world:
		world.queue_free()
		world = null
	await get_tree().process_frame
	await get_tree().process_frame


func _load_layout(size: int, seed_v: int) -> PackedByteArray:
	var path := "res://assets/layout_%d_%d.bin" % [size, seed_v]
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_error("missing layout " + path)
		return PackedByteArray()
	var magic := f.get_32()
	var sz := f.get_32()
	var sd := f.get_32()
	var count := f.get_32()
	var hash_expected := f.get_32()
	var data := f.get_buffer(count * 4)
	layout_blocks = count
	# FNV-style hash identical to FProfileLayout::Hash; blocks are already sorted (z,y,x).
	var h := _ue_hash(data, count)
	layout_hash = h
	if magic != 0x4C4D5349 or sz != size or h != hash_expected:
		push_error("layout file corrupt (hash %d != %d)" % [h, hash_expected])
		return PackedByteArray()
	return data


func _ue_hash(data: PackedByteArray, count: int) -> int:
	# AddInt32ToHash: 4 bytes little-endian per int32 (high bytes are 0 for our small values).
	var h := 2166136261
	for i in range(count):
		for j in range(4):
			var v := data[i * 4 + j]
			h = ((h ^ v) * 16777619) & 0xFFFFFFFF
			h = ((h ^ 0) * 16777619) & 0xFFFFFFFF
			h = ((h ^ 0) * 16777619) & 0xFFFFFFFF
			h = ((h ^ 0) * 16777619) & 0xFFFFFFFF
	for sh in [0, 8, 16, 24]:
		h = ((h ^ ((count >> sh) & 0xFF)) * 16777619) & 0xFFFFFFFF
	return h


func _begin_case() -> bool:
	await _clear_world()
	var size: int = cur_case.size
	var t0 := Time.get_ticks_usec()
	var data := _load_layout(size, opt.seed)
	generate_ms = (Time.get_ticks_usec() - t0) / 1000.0
	if data.is_empty():
		return false
	world = Node3D.new()
	add_child(world)
	t0 = Time.get_ticks_usec()
	if cur_case.mode == "ISM":
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.use_custom_data = true
		mm.mesh = box_mesh
		mm.instance_count = layout_blocks
		var buf := PackedFloat32Array()
		buf.resize(layout_blocks * 16)
		for i in range(layout_blocks):
			var p := _ue_to_godot(Vector3(data[i * 4], data[i * 4 + 1], data[i * 4 + 2]))
			var o := i * 16
			buf[o] = 1.0; buf[o + 1] = 0.0; buf[o + 2] = 0.0; buf[o + 3] = p.x
			buf[o + 4] = 0.0; buf[o + 5] = 1.0; buf[o + 6] = 0.0; buf[o + 7] = p.y
			buf[o + 8] = 0.0; buf[o + 9] = 0.0; buf[o + 10] = 1.0; buf[o + 11] = p.z
			buf[o + 12] = float(data[i * 4 + 3])
		mm.buffer = buf
		var mmi := MultiMeshInstance3D.new()
		mmi.multimesh = mm
		mmi.material_override = mat_ism
		world.add_child(mmi)
	else:
		for i in range(layout_blocks):
			var mi := MeshInstance3D.new()
			mi.mesh = box_mesh
			mi.material_override = mat_actor
			mi.position = _ue_to_godot(Vector3(data[i * 4], data[i * 4 + 1], data[i * 4 + 2]))
			mi.set_instance_shader_parameter("block_type", float(data[i * 4 + 3]))
			world.add_child(mi)
	build_ms = (Time.get_ticks_usec() - t0) / 1000.0
	# baseplate (UE: 100x100uu plane scaled to (S*100+18000)uu at z=-200uu)
	var plate := MeshInstance3D.new()
	var pm := PlaneMesh.new()
	pm.size = Vector2(size + 180.0, size + 180.0)
	plate.mesh = pm
	var c := (size - 1) * 0.5
	plate.position = _ue_to_godot(Vector3(c, c, -2.0))
	var pmat := StandardMaterial3D.new()
	pmat.albedo_color = Color(opt.plane, opt.plane, opt.plane)
	pmat.roughness = 1.0
	pmat.metallic_specular = 0.0
	plate.material_override = pmat
	world.add_child(plate)
	# camera: UE offset (-S*65, -S*65, S*115) cm from the terrain centre, looking at it, ortho width S*210 cm
	var centre_ue := Vector3(c, c, 0.0)
	var off_ue := Vector3(-size * 0.65, -size * 0.65, size * 1.15)
	cam.position = _ue_to_godot(centre_ue + off_ue)
	cam.look_at(_ue_to_godot(centre_ue), Vector3.UP)
	cam.size = size * 2.1
	# first frame cost (scene upload, shader/pipeline compile) -> excluded from measurement but recorded
	t0 = Time.get_ticks_usec()
	await RenderingServer.frame_post_draw
	await RenderingServer.frame_post_draw
	first_frame_ms = (Time.get_ticks_usec() - t0) / 1000.0
	print("World mode=%s seed=%d size=%d blocks=%d hash=%d build_ms=%.3f first_frame_ms=%.1f" % [
		cur_case.mode, opt.seed, size, layout_blocks, layout_hash, build_ms, first_frame_ms])
	return true


func _warmup_and_measure() -> void:
	s_frame.clear(); s_game.clear(); s_render.clear(); s_gpu.clear(); s_draw.clear(); s_prim.clear(); s_obj.clear(); s_setup.clear()
	phase = "warmup"
	phase_start = Time.get_ticks_usec() / 1e6
	last_tick_us = Time.get_ticks_usec()
	case_shot_done = false
	shot_wait_until = 0.0
	while phase != "done":
		await get_tree().process_frame
	return


func _process(_delta: float) -> void:
	if phase == "idle" or phase == "done":
		return
	var now_us := Time.get_ticks_usec()
	var frame_ms := (now_us - last_tick_us) / 1000.0
	last_tick_us = now_us
	var now := now_us / 1e6
	if phase == "warmup":
		if now - phase_start >= opt.warmup:
			if opt.shots and cur_case.repeat == 0 and not case_shot_done:
				_save_shot(opt.out.path_join("evidence-%s-size%d.png" % [cur_case.mode, cur_case.size]))
				case_shot_done = true
				shot_wait_until = now + 0.5
			if now >= shot_wait_until:
				phase = "measuring"
				phase_start = now
	elif phase == "measuring":
		s_frame.append(frame_ms)
		s_game.append(Performance.get_monitor(Performance.TIME_PROCESS) * 1000.0)
		s_render.append(RenderingServer.viewport_get_measured_render_time_cpu(viewport_rid))
		s_gpu.append(RenderingServer.viewport_get_measured_render_time_gpu(viewport_rid))
		s_draw.append(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME))
		s_prim.append(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME))
		s_obj.append(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME))
		s_setup.append(RenderingServer.get_frame_setup_time_cpu())
		if now - phase_start >= opt.seconds:
			phase = "done"


func _save_shot(path: String) -> void:
	var img := get_viewport().get_texture().get_image()
	img.save_png(path)


static func _pct(values: PackedFloat64Array, q: float) -> float:
	if values.is_empty():
		return 0.0
	var v := values.duplicate()
	v.sort()
	return v[clampi(int(ceil(q * v.size())) - 1, 0, v.size() - 1)]


func _working_set_mb() -> float:
	var out := []
	var code := OS.execute("powershell.exe", ["-NoProfile", "-Command", "(Get-Process -Id %d).WorkingSet64" % OS.get_process_id()], out)
	if code != 0 or out.is_empty():
		return 0.0
	return float(str(out[0]).strip_edges()) / 1048576.0


func _finish_case() -> void:
	var ws := _working_set_mb()
	var n := s_frame.size()
	var valid := n >= 10 and _pct(s_frame, 0.5) > 0.0
	var sum := 0.0
	for i in range(n):
		sum += s_frame[i]
		samples_csv += "%d,%d,%.6f,%.6f,%.6f,%.6f,%d,%d,%d\n" % [case_index, i, s_frame[i], s_game[i], s_render[i], s_gpu[i], s_draw[i], s_prim[i], s_obj[i]]
	var is_actor: bool = cur_case.mode == "Actor"
	summary_csv += "%d,%d,%s,%d,%d,%d,%d,%d,%d,%d,%.4f,%.4f,%.2f,%d,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.3f,%d,%d,%d,%.2f,%.2f,%d,%.6f\n" % [
		case_index, cur_case.repeat, cur_case.mode, opt.seed, cur_case.size, layout_blocks, layout_hash, 0,
		layout_blocks if is_actor else 0, layout_blocks if is_actor else 1, generate_ms, build_ms, first_frame_ms, n,
		sum / maxf(1.0, n), _pct(s_frame, 0.5), _pct(s_frame, 0.95), _pct(s_game, 0.5), _pct(s_render, 0.5), _pct(s_gpu, 0.5),
		ws, _pct(s_draw, 0.5), _pct(s_prim, 0.5), _pct(s_obj, 0.5),
		Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED) / 1048576.0,
		OS.get_static_memory_usage() / 1048576.0, 1 if valid else 0, _pct(s_setup, 0.5)]
	print("Case %d/%d complete mode=%s blocks=%d p50=%.3f p95=%.3f valid=%s" % [
		case_index + 1, cases.size(), cur_case.mode, layout_blocks, _pct(s_frame, 0.5), _pct(s_frame, 0.95), valid])
	if not valid:
		passed = false


func _write_environment() -> void:
	var adapter := RenderingServer.get_video_adapter_name()
	var env_d := {
		"engine": "Godot " + Engine.get_version_info().string,
		"platform": OS.get_name(),
		"cpu": OS.get_processor_name(),
		"gpu": adapter,
		"rhi": RenderingServer.get_current_rendering_driver_name(),
		"renderer": RenderingServer.get_current_rendering_method(),
		"driver_version": RenderingServer.get_video_adapter_api_version(),
		"timestamp_utc": Time.get_datetime_string_from_system(true),
		"warmup_seconds": opt.warmup, "measure_seconds": opt.seconds, "repeats": opt.repeats,
		"method": "same-process alternating AB/BA; wall frame times; process memory = working set sampled once at end of each case; GPU time from viewport_get_measured_render_time_gpu",
		"width": get_window().size.x, "height": get_window().size.y,
		"sun_energy": opt.sun, "ambient_energy": opt.ambient, "tag": opt.tag,
	}
	var f := FileAccess.open(opt.out.path_join("environment.json"), FileAccess.WRITE)
	f.store_string(JSON.stringify(env_d, "\t"))


func _finish_suite() -> void:
	phase = "idle"
	var f := FileAccess.open(opt.out.path_join("summary.csv"), FileAccess.WRITE)
	f.store_string(summary_csv)
	f.close()
	f = FileAccess.open(opt.out.path_join("samples.csv"), FileAccess.WRITE)
	f.store_string(samples_csv)
	f.close()
	f = FileAccess.open(opt.out.path_join("result.json"), FileAccess.WRITE)
	f.store_string(JSON.stringify({"passed": passed, "completed_cases": case_index, "expected_cases": cases.size(), "output": opt.out}, "\t"))
	f.close()
	print("PROFILE_COMPLETE passed=%s cases=%d output=%s" % [passed, case_index, opt.out])
	if not opt.no_quit:
		get_tree().quit(0 if passed else 1)
