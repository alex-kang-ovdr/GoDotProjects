# Copied to /opt/playhub/.env by setup-vm.sh (mode 600). Never commit the real file.

# Public host name. Without a domain use sslip.io with the VM's static IP, dashes for dots.
PLAYHUB_SITE=34-82-1-2.sslip.io
PLAYHUB_PUBLIC_ORIGIN=https://34-82-1-2.sslip.io
PLAYHUB_CHANNEL=dev

# Generated by setup-vm.sh (openssl rand -hex 32). Shared by Hub and Forge.
PLAYHUB_FORGE_INTERNAL_SECRET=

# Updated by deploy.sh on every deploy (immutable tags pushed by the Cloud Run pipeline).
HUB_IMAGE=us-west1-docker.pkg.dev/playhub-dev-2611/playhub-containers/hub:REPLACE_TAG
FORGE_IMAGE=us-west1-docker.pkg.dev/playhub-dev-2611/playhub-containers/forge:REPLACE_TAG
