; Engine configuration file.
; Tappy Chicken native Godot starter project.

config_version=5

[application]

config/name="Tappy Chicken"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A self-contained flap-and-dodge starter game."

[display]

window/size/viewport_width=480
window/size/viewport_height=640
window/size/window_width_override=480
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.53, 0.81, 0.92, 1)
