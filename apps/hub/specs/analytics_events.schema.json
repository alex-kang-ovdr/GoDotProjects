{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playhub.example.com/specs/analytics_events.schema.json",
  "title": "플랫폼 분석 이벤트 입력과 서버 확정 계약",
  "description": "계획용 스키마. root는 ClientEventBatch. 서버 확정 형태는 #/$defs/StoredAnalyticsEvent. event_id 중복 제거, 세션당 10초·60초 1회 확정, 인가·동의·시간/바이트 한도는 서버 구현 필요. 운영 파이프라인 구현 완료물이 아니다.",
  "$ref": "#/$defs/ClientEventBatch",
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "ImpressionProperties": {
      "type": "object",
      "properties": {
        "visible_fraction": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "visible_duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "document_visible": {
          "const": true
        },
        "skeleton": {
          "const": false
        },
        "ranking_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "visible_fraction",
        "visible_duration_ms",
        "document_visible",
        "skeleton"
      ],
      "additionalProperties": false
    },
    "CardClickProperties": {
      "type": "object",
      "properties": {
        "viewability_met": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "detail",
            "direct_play"
          ]
        },
        "ranking_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "viewability_met",
        "action"
      ],
      "additionalProperties": false,
      "description": "1초 이전 클릭은 viewability_met=false. 실제 impression 이벤트를 만들어 넣지 않는다."
    },
    "DetailProperties": {
      "type": "object",
      "properties": {
        "acquisition_source": {
          "enum": [
            "organic_search",
            "external_referral",
            "direct",
            "internal_home",
            "internal_search",
            "continue_play",
            "other"
          ]
        },
        "referrer_host": {
          "type": "string",
          "maxLength": 253
        },
        "route": {
          "enum": [
            "detail",
            "direct_play"
          ]
        }
      },
      "required": [
        "acquisition_source",
        "route"
      ],
      "additionalProperties": false,
      "description": "referrer는 host만 허용하며 query나 URL token을 넣지 않는다."
    },
    "PlayClickProperties": {
      "type": "object",
      "properties": {
        "click_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "enum": [
            "detail_play",
            "direct_play",
            "continue_play"
          ]
        },
        "acquisition_source": {
          "enum": [
            "organic_search",
            "external_referral",
            "direct",
            "internal_home",
            "internal_search",
            "continue_play",
            "other"
          ]
        }
      },
      "required": [
        "click_id",
        "action",
        "acquisition_source"
      ],
      "additionalProperties": false
    },
    "ReadyProperties": {
      "type": "object",
      "properties": {
        "sdk_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "ready_source": {
          "const": "sdk"
        },
        "load_time_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "required": [
        "sdk_version",
        "ready_source"
      ],
      "additionalProperties": false,
      "description": "클라이언트 ready는 실행 준비 신호이며 실제 사람 또는 점수의 보안 증명이 아니다."
    },
    "HeartbeatProperties": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "active_delta_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "monotonic_ms": {
          "type": "number",
          "minimum": 0
        },
        "document_visible": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "last_interaction_age_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "game_updating": {
          "type": "boolean"
        }
      },
      "required": [
        "sequence",
        "active_delta_ms",
        "monotonic_ms",
        "document_visible",
        "paused",
        "game_updating"
      ],
      "additionalProperties": false,
      "description": "서버가 세션·순서·시간 상한·겹치는 탭을 검증한다. 보고 delta를 그대로 더하지 않는다."
    },
    "LifecycleProperties": {
      "type": "object",
      "properties": {
        "reason": {
          "enum": [
            "user",
            "background",
            "navigation",
            "completed",
            "restarted",
            "timeout",
            "runtime_error"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "reason",
        "sequence"
      ],
      "additionalProperties": false
    },
    "RoundStartProperties": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "difficulty_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "run_id",
        "mode_id"
      ],
      "additionalProperties": false
    },
    "RoundCompleteProperties": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "result": {
          "enum": [
            "win",
            "loss",
            "abandoned"
          ]
        },
        "active_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      },
      "required": [
        "run_id",
        "mode_id",
        "result",
        "active_duration_ms"
      ],
      "additionalProperties": false
    },
    "RestartProperties": {
      "type": "object",
      "properties": {
        "previous_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "enum": [
            "after_win",
            "after_loss",
            "manual"
          ]
        }
      },
      "required": [
        "previous_run_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "SearchProperties": {
      "type": "object",
      "properties": {
        "search_id": {
          "type": "string",
          "format": "uuid"
        },
        "query_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "query_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "search_id",
        "query_hash",
        "query_length"
      ],
      "additionalProperties": false,
      "description": "초기 계약은 raw 검색어와 URL을 수집하지 않는다. 검색 의도 분석이 필요하면 별도 동의·보존 정책을 검토한다."
    },
    "MilestoneProperties": {
      "type": "object",
      "properties": {
        "threshold_seconds": {
          "enum": [
            10,
            60
          ]
        },
        "validated_active_ms": {
          "type": "integer",
          "minimum": 10000
        },
        "validation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "threshold_seconds",
        "validated_active_ms",
        "validation_version"
      ],
      "additionalProperties": false
    },
    "ServerSessionProperties": {
      "type": "object",
      "properties": {
        "acquisition_source": {
          "enum": [
            "organic_search",
            "external_referral",
            "direct",
            "internal_home",
            "internal_search",
            "continue_play",
            "other"
          ]
        },
        "sdk_expected": {
          "type": "boolean"
        }
      },
      "required": [
        "acquisition_source",
        "sdk_expected"
      ],
      "additionalProperties": false
    },
    "ServerIdentityProperties": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "started",
            "connected",
            "existing_account",
            "declined",
            "error",
            "merged"
          ]
        },
        "progress_linked": {
          "type": "boolean"
        },
        "analytics_history_linked": {
          "type": "boolean"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    "ServerSaveProperties": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "outcome": {
          "enum": [
            "created",
            "updated",
            "conflict"
          ]
        }
      },
      "required": [
        "slot",
        "outcome"
      ],
      "additionalProperties": false
    },
    "ClientEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_name": {
          "enum": [
            "game_impression",
            "game_card_click",
            "game_detail_view",
            "play_click",
            "game_ready",
            "play_heartbeat",
            "game_pause",
            "game_resume",
            "game_end",
            "round_start",
            "round_complete",
            "restart_click",
            "search_submit",
            "search_results"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "page_view_id": {
          "type": "string",
          "format": "uuid"
        },
        "web_session_id": {
          "type": "string",
          "format": "uuid"
        },
        "play_session_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "game_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "build_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "placement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "slot_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "impression_id": {
          "type": "string",
          "format": "uuid"
        },
        "creative_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "event_name",
        "schema_version",
        "occurred_at",
        "properties"
      ],
      "additionalProperties": false,
      "description": "쿠키·세션에서 확정할 subject_id, received_at, consent_state, is_test는 클라이언트 입력에 없다.",
      "allOf": [
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "game_impression"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/ImpressionProperties"
              },
              "page_view_id": {
                "type": "string",
                "format": "uuid"
              },
              "web_session_id": {
                "type": "string",
                "format": "uuid"
              },
              "game_id": {
                "$ref": "#/$defs/OpaqueId"
              },
              "placement_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "slot_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "impression_id": {
                "type": "string",
                "format": "uuid"
              },
              "creative_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "page_view_id",
              "web_session_id",
              "game_id",
              "placement_id",
              "slot_index",
              "impression_id",
              "creative_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "game_card_click"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/CardClickProperties"
              },
              "page_view_id": {
                "type": "string",
                "format": "uuid"
              },
              "web_session_id": {
                "type": "string",
                "format": "uuid"
              },
              "game_id": {
                "$ref": "#/$defs/OpaqueId"
              },
              "placement_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "slot_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "impression_id": {
                "type": "string",
                "format": "uuid"
              },
              "creative_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "page_view_id",
              "web_session_id",
              "game_id",
              "placement_id",
              "slot_index",
              "impression_id",
              "creative_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "game_detail_view"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/DetailProperties"
              },
              "page_view_id": {
                "type": "string",
                "format": "uuid"
              },
              "web_session_id": {
                "type": "string",
                "format": "uuid"
              },
              "game_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "page_view_id",
              "web_session_id",
              "game_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "play_click"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/PlayClickProperties"
              },
              "page_view_id": {
                "type": "string",
                "format": "uuid"
              },
              "web_session_id": {
                "type": "string",
                "format": "uuid"
              },
              "game_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "page_view_id",
              "web_session_id",
              "game_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "game_ready"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/ReadyProperties"
              },
              "play_session_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "play_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "play_heartbeat"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/HeartbeatProperties"
              },
              "play_session_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "play_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "game_pause",
                  "game_resume",
                  "game_end"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/LifecycleProperties"
              },
              "play_session_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "play_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "round_start"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/RoundStartProperties"
              },
              "play_session_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "play_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "round_complete"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/RoundCompleteProperties"
              },
              "play_session_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "play_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "restart_click"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/RestartProperties"
              },
              "play_session_id": {
                "$ref": "#/$defs/OpaqueId"
              }
            },
            "required": [
              "play_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "enum": [
                  "search_submit",
                  "search_results"
                ]
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "#/$defs/SearchProperties"
              },
              "page_view_id": {
                "type": "string",
                "format": "uuid"
              },
              "web_session_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "page_view_id",
              "web_session_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "event_name": {
                "const": "search_results"
              }
            },
            "required": [
              "event_name"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "required": [
                  "result_count"
                ]
              }
            }
          }
        }
      ]
    },
    "ClientEventBatch": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/ClientEvent"
          }
        }
      },
      "required": [
        "schema_version",
        "events"
      ],
      "additionalProperties": false,
      "description": "P0 G1 입력. HTTP 본문 64KiB 제한은 서버 추가 검사. 재시도는 event_id 유지. 수집 전용 방문 session은 game_impression, game_card_click, game_detail_view, play_click, search_submit, search_results만 전송 가능. SDK gameplay 이벤트는 플랫폼 session과 play session 인가 필수. 이 권한 차이는 JSON Schema 밖에서 검증한다."
    },
    "StoredAnalyticsEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_name": {
          "enum": [
            "game_impression",
            "game_card_click",
            "game_detail_view",
            "play_click",
            "game_ready",
            "play_heartbeat",
            "game_pause",
            "game_resume",
            "game_end",
            "round_start",
            "round_complete",
            "restart_click",
            "search_submit",
            "search_results",
            "play_session_created",
            "active_play_10s",
            "active_play_60s",
            "google_login_start",
            "google_login_complete",
            "guest_merge_complete",
            "save_write_success",
            "save_write_conflict"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "page_view_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "web_session_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "play_session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ]
        },
        "game_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
