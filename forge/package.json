{
  "name": "playforge-godot",
  "version": "0.1.0",
  "private": true,
  "description": "Godot GDScript runtime with collaborative PlayForge Studio",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.cjs",
    "test": "node Tools/run-tests.cjs",
    "test:integration": "node --test Tests/integration.test.cjs",
    "test:browser": "playwright test",
    "build:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File Tools/build-engine.ps1",
    "test:loop": "node Tools/regression-loop.cjs",
    "build:studio": "node Tools/build-studio.cjs",
    "play": "node Tools/run-godot.cjs",
    "editor": "node Tools/run-godot.cjs --editor",
    "test:visible": "node Tools/test-godot-visible.cjs",
    "export:godot": "node Tools/export-godot-project.cjs",
    "build:launchers": "powershell -NoProfile -ExecutionPolicy Bypass -File Tools/Launchers/build-launchers.ps1 -SelfTest",
    "test:web-runtime": "node Tools/test-godot-web.cjs",
    "install:web-editor": "powershell -NoProfile -ExecutionPolicy Bypass -File Tools/install-web-editor.ps1",
    "test:official-editor": "node Tools/test-godot-web.cjs --official",
    "test:platform": "node --test Tests/playforge_platform/platform.test.cjs Tests/playforge_platform/platform-service.test.cjs Tests/playforge_platform/guided.test.cjs",
    "test:game-templates": "node --test Tests/game-templates.test.cjs Tests/game-template-runtime.test.cjs",
    "test:ironwood-physics": "node --test Tests/ironwood-physics.test.cjs",
    "test:brawllabs-multiplayer": "node --test Tests/brawllabs-multiplayer.test.cjs Tests/brawllabs-browser.test.cjs",
    "test:editor-game-embedding": "node --test Tests/playforge_platform/editor-game-embedding.test.cjs",
    "test:multiplayer-workspace": "node --test Tests/multiplayer-workspace-browser.test.cjs",
    "test:editor-join-sync": "node --test Tests/playforge_platform/editor-join-sync.test.cjs",
    "test:template-showcase": "node --test Tests/playforge_replay/template-showcase.test.cjs",
    "test:playforge-replay": "node --test Tests/playforge_replay/template-showcase.test.cjs Tests/playforge_replay/showcase-feedback.test.cjs Tests/playforge_replay/showcase-gestures.test.cjs",
    "test:playforge-agent-chat": "node --test Tests/playforge_agent_chat/agent-chat.test.cjs Tests/playforge_agent_chat/agent-chat-conversation.test.cjs Tests/playforge_agent_chat/agent-provider.test.cjs Tests/playforge_agent_chat/agent-codex-protocol.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "ws": "^8.23.0",
    "yjs": "^13.6.33"
  }
}
