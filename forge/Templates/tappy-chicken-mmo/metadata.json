{
  "id": "tappy-chicken-mmo",
  "name": "Tappy Chicken MMO",
  "description": "Drop-in multiplayer Tappy Chicken: your own gameplay stays untouched while nearby players' actions are relayed via server RPC multicast and rendered at 50% opacity.",
  "dimension": "2d",
  "assetPaths": [
    "Assets/chicken.svg",
    "Assets/chicken-wing-up.svg",
    "Assets/chicken-wing-down.svg",
    "Assets/chicken-hit.svg",
    "Assets/clouds-far.svg",
    "Assets/clouds-near.svg",
    "Assets/hills-far.svg",
    "Assets/hills-near.svg",
    "Assets/plants.svg",
    "Assets/fence.svg",
    "Assets/ground.svg",
    "Assets/pipe.svg",
    "Assets/pipe-down.svg",
    "Assets/logo.svg",
    "Assets/play.svg",
    "Assets/ready.svg",
    "Assets/go.svg",
    "Assets/game-over.svg",
    "Assets/scoreboard.svg",
    "Assets/egg.svg",
    "Assets/digits.svg",
    "Assets/Audio/SFX_Click_01.tres",
    "Assets/Audio/SFX_FlapWing_01.tres",
    "Assets/Audio/SFX_FlapWing_02.tres",
    "Assets/Audio/SFX_FlapWing_03.tres",
    "Assets/Audio/SFX_FlapWing_04.tres",
    "Assets/Audio/SFX_Score_01.tres",
    "Assets/Audio/SFX_HitObstacle_01.tres",
    "Assets/Audio/SFX_HitGround_01.tres"
  ],
  "guideOrder": [
    "Scripts/Game.gd",
    "Scripts/MmoNetwork.gd",
    "Scripts/Main.gd",
    "scenes/main.tscn",
    "project.godot"
  ],
  "guide": "README.md",
  "publishDefaults": {
    "deployProfile": {
      "deployMode": "mmo",
      "serverRuntime": "relay-spatial-v1",
      "specTier": "small",
      "lobbyMode": "stateless_ui",
      "relayConfig": {
        "dimensions": 1,
        "aoiRadius": 520,
        "aoiHysteresis": 60,
        "maxPlayersPerChannel": 64,
        "maxVisiblePeers": 12,
        "flushIntervalMs": 50,
        "maxPayloadBytes": 512,
        "sharedRoomSeed": true,
        "extrapolateVelocity": true,
        "maxVelocity": 400
      },
      "channelPolicy": {
        "autoChanneling": true,
        "softCapPerChannel": 64,
        "hideChannelUiWhenSingle": true
      },
      "lifecycle": {
        "alwaysOn": false,
        "idleSleepSec": 600,
        "afkKickSec": 1200
      }
    },
    "gameMetadata": {
      "slug": "tappy-chicken-mmo",
      "title": {
        "ko": "태피 치킨 MMO",
        "en": "Tappy Chicken MMO"
      },
      "summary": {
        "ko": "주변 플레이어의 비행이 50% 반투명 고스트로 실시간 중계되는 MMO 태피 치킨",
        "en": "Drop-in multiplayer Tappy Chicken MMO with 50% translucent nearby ghosts."
      },
      "instructions": {
        "ko": "스페이스바·클릭 또는 화면 탭으로 날갯짓하세요. P로 일시정지, R로 재시작합니다.",
        "en": "Press Space, click, or tap to flap. P to pause, R to restart."
      },
      "tags": ["arcade", "multiplayer"],
      "controls": ["keyboard", "mouse", "touch"],
      "viewport": {
        "width": 480,
        "height": 640,
        "orientation": "portrait",
        "resize": "fit"
      }
    }
  }
}
