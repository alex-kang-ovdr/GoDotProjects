; Engine configuration file.
; Automatically generated by PlayForge Unity-to-Godot Converter (Tanks! 3D)

config_version=5

[application]

config/name="Tanks! 3D (Unity Official Tutorial -> Godot 4.7.2 Port)"
config/description="Automated port of Unity 3D Tanks! (26 FBX models, 103 binary prefab level objects, 21 binary materials, 2P local battle)"
