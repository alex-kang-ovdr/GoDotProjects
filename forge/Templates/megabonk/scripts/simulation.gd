func _addGem(x, z, value):
	if J.truthy(J.compare(value, 0.0, "<=")):
		return
	if J.truthy(J.compare(J.length(self.xpGems), self.maxGems, ">=")):
		var nearest = J.getv(self.xpGems, 0.0)
		var distance = INF
		for gem in self.xpGems:
			var d = J.add(pow(J.num((J.num(J.getv(gem, "x")) - J.num(x))), J.num(2.0)), pow(J.num((J.num(J.getv(gem, "z")) - J.num(z))), J.num(2.0)))
			if J.truthy(J.compare(d, distance, "<")):
				nearest = gem
				distance = d
		nearest["value"] = J.add(J.getv(nearest, "value"), value)
		return
	J.push(self.xpGems, {"id": _id(), "x": x, "z": z, "y": J.add(_ground(x, z), 0.25), "value": value, "attracted": false})

func grantXP(amount):
	if J.truthy(J.or_value(J.or_value(self._terminal, func(): return (not J.truthy(J.is_finite_value(amount)))), func(): return J.compare(amount, 0.0, "<="))):
		return false
	self.player["xp"] = J.add(J.getv(self.player, "xp"), (J.num(amount) * J.num(J.getv(self.player, "xpGain"))))
	return true

func _updatePickups(dt):
	var p = self.player
	for gem in self.xpGems:
		var d = magnitude((J.num(J.getv(p, "x")) - J.num(J.getv(gem, "x"))), (J.num(J.getv(p, "z")) - J.num(J.getv(gem, "z"))))
		if J.truthy(J.or_value(J.compare(d, J.getv(p, "pickupRadius"), "<"), func(): return self.bossDefeated)):
			gem["attracted"] = true
		if J.truthy(J.getv(gem, "attracted")):
			var step = min(J.num(d), J.num((J.num(dt) * J.num(J.add(14.0, (J.num(d) * J.num(3.0)))))))
			if J.truthy(J.compare(d, 0.01, ">")):
				gem["x"] = J.add(J.getv(gem, "x"), (J.num((J.num((J.num(J.getv(p, "x")) - J.num(J.getv(gem, "x")))) / J.num(d))) * J.num(step)))
				gem["z"] = J.add(J.getv(gem, "z"), (J.num((J.num((J.num(J.getv(p, "z")) - J.num(J.getv(gem, "z")))) / J.num(d))) * J.num(step)))
			gem["y"] = J.add(J.getv(gem, "y"), (J.num((J.num(J.add(J.getv(p, "y"), 0.7)) - J.num(J.getv(gem, "y")))) * J.num(min(J.num(1.0), J.num((J.num(dt) * J.num(8.0)))))))
		if J.truthy(J.compare(d, 0.8, "<")):
			grantXP(J.getv(gem, "value"))
			gem["collected"] = true
	self.xpGems = J.filterv(self.xpGems, func(g): return (not J.truthy(J.getv(g, "collected"))))
	for drop in self.drops:
		if J.truthy((J.eq(J.getv(drop, "kind"), "portal"))):
			continue
		drop["life"] = (J.num(J.getv(drop, "life")) - J.num(dt))
		var d = magnitude((J.num(J.getv(p, "x")) - J.num(J.getv(drop, "x"))), (J.num(J.getv(p, "z")) - J.num(J.getv(drop, "z"))))
		if J.truthy(J.compare(d, J.getv(p, "pickupRadius"), "<")):
			var step = min(J.num(d), J.num((J.num(dt) * J.num(17.0))))
			if J.truthy(J.compare(d, 0.01, ">")):
				drop["x"] = J.add(J.getv(drop, "x"), (J.num((J.num((J.num(J.getv(p, "x")) - J.num(J.getv(drop, "x")))) / J.num(d))) * J.num(step)))
				drop["z"] = J.add(J.getv(drop, "z"), (J.num((J.num((J.num(J.getv(p, "z")) - J.num(J.getv(drop, "z")))) / J.num(d))) * J.num(step)))
			drop["y"] = J.add(J.getv(drop, "y"), (J.num((J.num(J.add(J.getv(p, "y"), 0.3)) - J.num(J.getv(drop, "y")))) * J.num(min(J.num(1.0), J.num((J.num(dt) * J.num(8.0)))))))
		if J.truthy(J.compare(d, 0.85, "<")):
			if J.truthy((J.eq(J.getv(drop, "kind"), "gold"))):
				p["gold"] = J.add(J.getv(p, "gold"), (J.num(J.getv(drop, "value")) * J.num(J.getv(p, "goldGain"))))
			if J.truthy((J.eq(J.getv(drop, "kind"), "health"))):
				_heal(J.getv(drop, "value"))
			drop["life"] = 0.0
	self.drops = J.filterv(self.drops, func(d): return J.compare(J.getv(d, "life"), 0.0, ">"))

func _heal(amount):
	var p = self.player
	var gained = min(J.num(amount), J.num((J.num(J.getv(p, "maxHp")) - J.num(J.getv(p, "hp")))))
	p["hp"] = J.add(J.getv(p, "hp"), gained)
	if J.truthy(J.compare(gained, 0.0, ">")):
		_effect("heal", J.getv(p, "x"), J.getv(p, "z"), {"radius": 1.6, "color": "#91ef9b", "ttl": 0.6, "value": J.round_js(gained)})
		_event("heal", {"value": J.round_js(gained), "x": J.getv(p, "x"), "z": J.getv(p, "z")})

func _updateShrines(dt):
	for shrine in self.shrines:
		if J.truthy(J.and_value((J.eq(J.getv(shrine, "kind"), "charge")), func(): return (J.eq(J.getv(shrine, "state"), "charging")))):
			if J.truthy(J.and_value(J.compare(dist2(self.player, shrine), pow(J.num(J.getv(shrine, "radius")), J.num(2.0)), "<="), func(): return J.compare(_height(self.player), 2.0, "<"))):
				shrine["progress"] = min(J.num(1.0), J.num(J.add(J.getv(shrine, "progress"), (J.num(dt) / J.num(J.getv(shrine, "chargeDuration"))))))
			if J.truthy(J.compare(J.getv(shrine, "progress"), 1.0, ">=")):
				shrine["state"] = "ready"
		if J.truthy(J.and_value(J.and_value((J.eq(J.getv(shrine, "kind"), "combat")), func(): return (J.eq(J.getv(shrine, "state"), "active"))), func(): return J.every(J.getv(shrine, "enemyIds"), func(id): return (not J.truthy(J.some(self.enemies, func(e): return J.and_value((J.eq(J.getv(e, "id"), id)), func(): return (not J.truthy(J.getv(e, "dead")))))))))):
			shrine["state"] = "complete"
			shrine["used"] = true
			_addChest(J.add(J.getv(shrine, "x"), 1.8), J.getv(shrine, "z"), true)
			_event("toast", {"message": "도전 완료 · 성소 옆 무료 상자를 확인하세요"})
			_effect("ring", J.getv(shrine, "x"), J.getv(shrine, "z"), {"radius": 5.0, "color": "#ffe19a", "ttl": 0.8})

func _activateShrine(shrineId):
	if J.truthy(J.or_value((not J.eq(self.phase, "playing")), func(): return self._terminal)):
		return false
	var shrine = J.find(self.shrines, func(s): return (J.eq(J.getv(s, "id"), shrineId)))
	if J.truthy(J.or_value(J.or_value((not J.truthy(shrine)), func(): return J.getv(shrine, "used")), func(): return J.compare(dist2(self.player, shrine), pow(J.num(3.6), J.num(2.0)), ">"))):
		return false
	if J.truthy(J.and_value((J.eq(J.getv(shrine, "kind"), "greed")), func(): return (J.eq(J.getv(shrine, "state"), "idle")))):
		shrine["used"] = true
		shrine["state"] = "complete"
		var reward = J.round_js((J.num(_chestCost()) * J.num(0.1)))
		self.player["gold"] = J.add(J.getv(self.player, "gold"), reward)
		self.difficulty = J.add(self.difficulty, 0.05)
		_event("toast", {"message": ("탐욕의 거래 · " + J.string(reward) + " 골드 획득, 난도 +5%")})
		return true
	if J.truthy((J.eq(J.getv(shrine, "kind"), "charge"))):
		if J.truthy((J.eq(J.getv(shrine, "state"), "idle"))):
			shrine["state"] = "charging"
			_event("toast", {"message": "성소 충전 · 빛나는 원 안에 머무르세요"})
			return true
		if J.truthy(J.and_value((J.eq(J.getv(shrine, "state"), "ready")), func(): return (not J.truthy(J.getv(shrine, "rewardClaimed"))))):
			shrine["rewardClaimed"] = true
			shrine["used"] = true
			shrine["state"] = "complete"
			self._pendingLoot = J.getv(shrine, "id")
			self.offers = _shrineOffers()
			self.phase = "loot"
			_event("loot", {"message": "성소의 축복 · 강화 하나를 선택하세요"})
			return true
		return false
	if J.truthy(J.and_value((J.eq(J.getv(shrine, "kind"), "combat")), func(): return (J.eq(J.getv(shrine, "state"), "idle")))):
		shrine["state"] = "active"
		var pool = J.filterv(J.or_value(J.getv(J.getv(J.getv(self.map, "stages"), self.stageIndex), "minibossPool"), func(): return _enemyPool()), func(id): return J.getv(ENEMY_TYPES, id))
		var e = _spawnEnemy(self.rng.pick(pool), {"x": J.add(J.getv(shrine, "x"), 5.0), "z": J.add(J.getv(shrine, "z"), 1.0), "challenge": true})
		if J.truthy(e):
			J.push(J.getv(shrine, "enemyIds"), J.getv(e, "id"))
			e["challenge"] = true
			e["shrineId"] = J.getv(shrine, "id")
		else:
			shrine["state"] = "idle"
			return false
		_event("boss", {"message": "전투 성소 · 7배 체력의 도전 적을 처치하세요"})
		return true
	return false

func _updateInteraction():
	self.interaction = null
	var p = self.player
	var portal = self.portal
	if J.truthy(J.and_value(J.and_value(portal, func(): return (not J.truthy(J.getv(portal, "discovered")))), func(): return J.compare(dist2(p, portal), pow(J.num(12.0), J.num(2.0)), "<"))):
		portal["discovered"] = true
		_event("toast", {"message": "포털 발견 · E로 수호자를 소환할 수 있습니다"})
	if J.truthy(J.and_value(J.and_value(portal, func(): return J.getv(portal, "discovered")), func(): return J.compare(dist2(p, portal), pow(J.num(3.6), J.num(2.0)), "<"))):
		var label = ("E · 포털 수호자 소환" if J.truthy((J.eq(J.getv(portal, "state"), "dormant"))) else ("포털 봉인 · 수호자를 처치하세요" if J.truthy((J.eq(J.getv(portal, "state"), "guarded"))) else ("E · 다음 구역으로 이동" if J.truthy(J.compare(self.stageNumber, self.stageCount, "<")) else "E · 탐험 완주")))
		self.interaction = {"label": label, "enabled": (not J.eq(J.getv(portal, "state"), "guarded")), "targetId": J.getv(portal, "id"), "kind": "portal"}
		return
	var closest = null
	var d2 = pow(J.num(3.3), J.num(2.0))
	for shrine in self.shrines:
		if J.truthy(J.getv(shrine, "used")):
			continue
		var d = dist2(shrine, p)
		if J.truthy(J.compare(d, d2, ">=")):
			continue
		var label = ("E · 탐욕의 성소 · 골드와 난도 +5%" if J.truthy((J.eq(J.getv(shrine, "kind"), "greed"))) else (("도전 적을 처치하세요" if J.truthy((J.eq(J.getv(shrine, "state"), "active"))) else "E · 전투 성소 도전") if J.truthy((J.eq(J.getv(shrine, "kind"), "combat"))) else (("성소 충전 " + J.string(floor(J.num((J.num(J.getv(shrine, "progress")) * J.num(100.0))))) + "% · 원 안에 머무르세요") if J.truthy((J.eq(J.getv(shrine, "state"), "charging"))) else ("E · 충전 성소 보상" if J.truthy((J.eq(J.getv(shrine, "state"), "ready"))) else "E · 충전 성소 활성화"))))
		closest = {"label": label, "enabled": J.includes(["idle", "ready"], J.getv(shrine, "state")), "targetId": J.getv(shrine, "id"), "kind": "shrine"}
		d2 = d
	for chest in self.chests:
		if J.truthy(J.getv(chest, "opened")):
			continue
		chest["cost"] = (0.0 if J.truthy(J.or_value(J.getv(chest, "free"), func(): return J.getv(chest, "keyFree"))) else _chestCost())
		var d = dist2(chest, p)
		if J.truthy(J.compare(d, d2, "<")):
			closest = {"targetId": J.getv(chest, "id"), "kind": "chest", "cost": J.getv(chest, "cost"), "enabled": J.or_value(J.compare(J.getv(p, "gold"), J.getv(chest, "cost"), ">="), func(): return J.and_value(J.compare(J.getv(self.items, "Key"), 0.0, ">"), func(): return (not J.truthy(J.getv(chest, "keyRolled"))))), "label": ("E · 무료 상자 열기" if J.truthy((J.eq(J.getv(chest, "cost"), 0.0))) else ("E · 상자 열기 · " + J.string(J.getv(chest, "cost")) + " 골드"))}
			d2 = d
	self.interaction = closest

func _interact():
	if J.truthy(J.or_value(J.or_value((not J.truthy(self.interaction)), func(): return (not J.truthy(J.getv(self.interaction, "enabled")))), func(): return (not J.eq(self.phase, "playing")))):
		return false
	if J.truthy((J.eq(J.getv(self.interaction, "kind"), "portal"))):
		var portal = self.portal
		if J.truthy(J.or_value(J.or_value((not J.truthy(portal)), func(): return (not J.eq(J.getv(portal, "id"), J.getv(self.interaction, "targetId")))), func(): return J.compare(dist2(self.player, portal), pow(J.num(3.6), J.num(2.0)), ">="))):
			return false
		if J.truthy((J.eq(J.getv(portal, "state"), "dormant"))):
			_spawnBoss()
			return true
		if J.truthy((J.eq(J.getv(portal, "state"), "ready"))):
			return _transitionStage(J.getv(portal, "id"))
		return false
	if J.truthy((J.eq(J.getv(self.interaction, "kind"), "shrine"))):
		return _activateShrine(J.getv(self.interaction, "targetId"))
	return openChest(J.getv(self.interaction, "targetId"))

func openChest(id):
	if J.truthy(J.or_value((not J.eq(self.phase, "playing")), func(): return self._terminal)):
		return false
	var chest = J.find(self.chests, func(c): return (J.eq(J.getv(c, "id"), id)))
	if J.truthy(J.or_value(J.or_value((not J.truthy(chest)), func(): return J.getv(chest, "opened")), func(): return J.compare(dist2(chest, self.player), pow(J.num(3.2), J.num(2.0)), ">"))):
		return false
	if J.truthy(J.and_value(J.and_value((not J.truthy(J.getv(chest, "free"))), func(): return (not J.truthy(J.getv(chest, "keyRolled")))), func(): return J.compare(J.getv(self.items, "Key"), 0.0, ">"))):
		chest["keyRolled"] = true
		var chance = (J.num((J.num(0.1) * J.num(J.getv(self.items, "Key")))) / J.num(J.add(1.0, (J.num(0.1) * J.num(J.getv(self.items, "Key"))))))
		chest["keyFree"] = J.compare(self.rng.next(), chance, "<")
	chest["cost"] = (0.0 if J.truthy(J.or_value(J.getv(chest, "free"), func(): return J.getv(chest, "keyFree"))) else _chestCost())
	if J.truthy(J.compare(J.getv(self.player, "gold"), J.getv(chest, "cost"), "<")):
		_event("toast", {"message": "골드가 부족합니다. 주변 적을 처치해 보세요"})
		return false
	self.player["gold"] = (J.num(J.getv(self.player, "gold")) - J.num(J.getv(chest, "cost")))
	chest["opened"] = true
	if J.truthy((not J.truthy(J.getv(chest, "free")))):
		self.openedChests = J.num(self.openedChests) + 1
	if J.truthy(J.getv(self.items, "CreditCardRed")):
		self._passiveState["redCardDamage"] = J.add(J.or_value(J.getv(self._passiveState, "redCardDamage"), func(): return 0.0), (J.num(0.025) * J.num(J.getv(self.items, "CreditCardRed"))))
		_recalculate()
	self._pendingLoot = J.getv(chest, "id")
	self.offers = _lootOffers()
	self.phase = "loot"
	self.interaction = null
	_event("loot", {"x": J.getv(chest, "x"), "z": J.getv(chest, "z"), "value": J.getv(chest, "cost"), "message": "상자 보상 · 아이템 하나를 선택하세요"})
	_effect("explosion", J.getv(chest, "x"), J.getv(chest, "z"), {"radius": 2.0, "color": "#ffe19b", "ttl": 0.55})
	return true

func _shrineOffers():
	var sourceKeys = {"Damage": "Damage", "Cooldown": "AttackSpeed", "Precision": "CritChance", "Quantity": "Projectiles", "Size": "Size", "Duration": "Duration", "Armor": "Armor", "Health": "MaxHp", "Regeneration": "HpRegen", "Agility": "MoveSpeed", "Luck": "Luck", "Xp": "XpGain", "Attraction": "PickupRange", "Evasion": "Evasion", "Shield": "Shield", "ProjectileSpeed": "ProjectileSpeed", "Knockback": "Knockback", "Blood": "Lifesteal"}
	var sourceValues = J.map_new(J.mapv(J.getv(PROGRESSION_SOURCE, "statOfferCommonValues"), func(row): return [J.getv(row, "stat"), J.getv(row, "value")]))
	var pool = J.mapv(J.filterv(TOMES.values(), func(t): return J.has(sourceValues, J.getv(sourceKeys, J.getv(t, "id")))), func(t): return J.merge([t, {"stat": ("damage" if J.truthy((J.eq(J.getv(t, "id"), "Damage"))) else J.getv(t, "stat")), "amount": J.getv(sourceValues, J.getv(sourceKeys, J.getv(t, "id")))}]))
	var selected = []
	while J.truthy(J.and_value(J.compare(J.length(selected), 3.0, "<"), func(): return J.length(pool))):
		J.push(selected, J.getv(J.splice(pool, floor(J.num((J.num(self.rng.next()) * J.num(J.length(pool))))), 1.0), 0.0))
	return J.mapv(selected, func(tome):
		var rarity = _rollRarity()
		var factor = J.getv(rarityValues, rarity)
		var value = (J.num(J.getv(tome, "amount")) * J.num(factor))
		var flat = J.includes(["maxHp", "shield", "regen", "projectiles"], J.getv(tome, "stat"))
		var formatted = J.num(J.to_fixed((J.num(value) * J.num((1.0 if J.truthy(flat) else 100.0))), 2.0))
		return {"id": _id(), "kind": "stat", "targetId": J.getv(tome, "id"), "stat": J.getv(tome, "stat"), "amount": J.getv(tome, "amount"), "factor": factor, "value": value, "label": J.add(J.replacev(J.getv(tome, "name"), "의 서$", ""), " 축복"), "icon": J.getv(tome, "icon"), "color": J.getv(tome, "color"), "rarity": rarity, "rarityName": J.getv(rarityNames, rarity), "rarityColor": J.getv(rarityColors, rarity), "description": ("능력치 +" + J.string(formatted) + J.string((" HP/분" if J.truthy((J.eq(J.getv(tome, "stat"), "regen"))) else ("" if J.truthy(flat) else "%"))) + " · 슬롯을 사용하지 않는 영구 축복")}
	)

func _rollRarity():
	var luck = max(J.num(0.0), J.num(J.getv(self.player, "luck")))
	var names = ["Common", "Uncommon", "Rare", "Epic", "Legendary"]
	var base = [1.5, 0.3, 0.15, 0.04, 0.0085]
	var weights = J.mapv(base, func(w, i): return (J.num(w) * J.num(pow(J.num(1.5), J.num((J.num((J.num((-J.num((J.num(4.0) - J.num(i))))) * J.num(1.5))) * J.num(log(J.num(J.add(1.0, luck))))))))))
	var roll = (J.num(self.rng.next()) * J.num(J.reducev(weights, func(a, b): return J.add(a, b), 0.0)))
	if true:
		var i = 0.0
		var _first_1 = true
		while true:
			if not _first_1:
				i = J.num(i) + 1
			_first_1 = false
			if not J.truthy(J.compare(i, J.length(names), "<")):
				break
			roll = (J.num(roll) - J.num(J.getv(weights, i)))
			if J.truthy(J.compare(roll, 0.0, "<=")):
				return J.getv(names, i)
	return "Legendary"

func _weaponUpgradeLines(def):
	var all = J.or_value(J.getv(def, "upgrades"), func(): return [])
	var damage = J.find(all, func(line): return (J.eq(J.getv(line, "stat"), "DamageMultiplier")))
	var others = J.filterv(all, func(line): return (not J.eq(line, damage)))
	var selected = []
	if J.truthy(damage):
		J.push(selected, damage)
	if J.truthy(J.length(others)):
		J.push(selected, self.rng.pick(others))
	return selected

func _levelOffers():
	var candidates = []
	for def in WEAPONS.values():
		var owned = J.find(self.weapons, func(w): return (J.eq(J.getv(w, "id"), J.getv(def, "id"))))
		if J.truthy(J.and_value((not J.truthy(owned)), func(): return J.compare(J.length(self.weapons), self.maxWeaponSlots, ">="))):
			continue
		if J.truthy(J.and_value(owned, func(): return J.compare(J.getv(owned, "level"), 40.0, ">="))):
			continue
		J.push(candidates, {"kind": "weapon", "targetId": J.getv(def, "id"), "owned": J.truthy(owned)})
	for tome in TOMES.values():
		if J.truthy(J.and_value((not J.truthy(J.getv(self.tomes, J.getv(tome, "id")))), func(): return J.compare(J.length(self.tomes.keys()), self.maxTomeSlots, ">="))):
			continue
		J.push(candidates, {"kind": "tome", "targetId": J.getv(tome, "id")})
	var selected = []
	var newWeapons = J.filterv(candidates, func(c): return J.and_value((J.eq(J.getv(c, "kind"), "weapon")), func(): return (not J.truthy(J.getv(c, "owned")))))
	if J.truthy(J.and_value(J.and_value(J.compare(J.length(self.weapons), self.maxWeaponSlots, "<"), func(): return J.length(newWeapons)), func(): return J.compare(J.getv(self.player, "level"), 8.0, "<="))):
		J.push(selected, self.rng.pick(newWeapons))
	var tomeCandidates = J.filterv(candidates, func(c): return (J.eq(J.getv(c, "kind"), "tome")))
	if J.truthy(J.length(tomeCandidates)):
		J.push(selected, self.rng.pick(tomeCandidates))
	while J.truthy(J.and_value(J.compare(J.length(selected), 3.0, "<"), func(): return J.compare(J.length(selected), J.length(candidates), "<"))):
		var remaining = J.filterv(candidates, func(c): return (not J.truthy(J.some(selected, func(s): return J.and_value((J.eq(J.getv(s, "kind"), J.getv(c, "kind"))), func(): return (J.eq(J.getv(s, "targetId"), J.getv(c, "targetId"))))))))
		J.push(selected, self.rng.pick(remaining))
	return J.mapv(selected, func(c):
		var rarity = _rollRarity()
		var factor = J.getv(rarityValues, rarity)
		var def = (J.getv(WEAPONS, J.getv(c, "targetId")) if J.truthy((J.eq(J.getv(c, "kind"), "weapon"))) else J.getv(TOMES, J.getv(c, "targetId")))
		var owned = J.find(self.weapons, func(w): return (J.eq(J.getv(w, "id"), J.getv(c, "targetId"))))
		var level = (J.add(J.or_value(J.getv(owned, "level"), func(): return 0.0), 1.0) if J.truthy((J.eq(J.getv(c, "kind"), "weapon"))) else J.add(J.or_value(J.getv(self.tomes, J.getv(c, "targetId")), func(): return 0.0), 1.0))
		var upgradeLines = (_weaponUpgradeLines(def) if J.truthy(J.and_value((J.eq(J.getv(c, "kind"), "weapon")), func(): return owned)) else [])
		return J.merge([{"id": _id()}, c, {"label": (J.string(J.getv(def, "name")) + " " + J.string((("Lv." + J.string(level)) if J.truthy(J.or_value(owned, func(): return (J.eq(J.getv(c, "kind"), "tome")))) else "획득"))), "description": J.getv(def, "description"), "rarity": rarity, "rarityName": J.getv(rarityNames, rarity), "color": J.getv(rarityColors, rarity), "icon": J.getv(def, "icon"), "level": level, "factor": factor, "upgradeLines": upgradeLines, "isNew": J.and_value((J.eq(J.getv(c, "kind"), "weapon")), func(): return (not J.truthy(owned)))}])
	)

func _lootOffers():
	var available = ITEMS.values()
	var chosen = []
	while J.truthy(J.compare(J.length(chosen), min(J.num(3.0), J.num(J.length(available))), "<")):
		var weighted = J.filterv(available, func(item): return (not J.truthy(J.includes(chosen, item))))
		var sumState = {"value": 0.0}
		var weights = J.mapv(weighted, func(item):
			var rarity = J.or_value(J.getv(item, "rarity"), func(): return "Common")
			var w = J.or_value(J.getv({"Common": 7.0, "Uncommon": 5.0, "Rare": 4.0, "Epic": 2.0, "Legendary": 0.8}, rarity), func(): return 3.0)
			var luckBonus = (J.add(1.0, J.getv(self.player, "luck")) if J.truthy(J.or_value((J.eq(rarity, "Epic")), func(): return (J.eq(rarity, "Legendary")))) else 1.0)
			sumState["value"] = J.add(J.getv(sumState, "value"), (J.num(w) * J.num(luckBonus)))
			return (J.num(w) * J.num(luckBonus))
		)
		var roll = (J.num(self.rng.next()) * J.num(J.getv(sumState, "value")))
		var choice = J.getv(weighted, 0.0)
		if true:
			var i = 0.0
			var _first_1 = true
			while true:
				if not _first_1:
					i = J.num(i) + 1
				_first_1 = false
				if not J.truthy(J.compare(i, J.length(weighted), "<")):
					break
				roll = (J.num(roll) - J.num(J.getv(weights, i)))
				if J.truthy(J.compare(roll, 0.0, "<=")):
					choice = J.getv(weighted, i)
					break
		J.push(chosen, choice)
	return J.mapv(chosen, func(item): return {"id": _id(), "kind": "item", "targetId": J.getv(item, "id"), "label": J.getv(item, "name"), "description": J.getv(item, "description"), "rarity": J.or_value(J.getv(item, "rarity"), func(): return "Common"), "icon": J.getv(item, "icon"), "color": J.getv(item, "color"), "level": J.add(J.or_value(J.getv(self.items, J.getv(item, "id")), func(): return 0.0), 1.0)})

func _checkLevelUp():
	var p = self.player
	if J.truthy(J.or_value(J.compare(J.getv(p, "xp"), J.getv(p, "xpNext"), "<"), func(): return self.bossDefeated)):
		return
	p["xp"] = (J.num(J.getv(p, "xp")) - J.num(J.getv(p, "xpNext")))
	p["level"] = J.num(J.getv(p, "level")) + 1
	p["xpNext"] = _xpForLevel(J.getv(p, "level"))
	_recalculate()
	_heal(max(J.num(3.0), J.num((J.num(J.getv(p, "maxHp")) * J.num(0.035)))))
	self.offers = _levelOffers()
	if J.truthy((not J.truthy(J.length(self.offers)))):
		self.player["gold"] = J.add(J.getv(self.player, "gold"), 20.0)
		return
	self.phase = "levelup"
	_event("levelup", {"value": J.getv(p, "level"), "message": ("레벨 " + J.string(J.getv(p, "level")) + " · 강화 선택")})
	_effect("ring", J.getv(p, "x"), J.getv(p, "z"), {"radius": 4.0, "color": "#a6efdf", "ttl": 0.8})

func choose(index):
	if J.truthy(J.or_value(J.or_value(J.or_value((not J.truthy(J.includes(["levelup", "loot"], self.phase))), func(): return (not J.truthy(J.is_integer(index)))), func(): return (not J.truthy(J.getv(self.offers, index)))), func(): return self._terminal)):
		return false
	var offer = J.getv(self.offers, index)
	if J.truthy((J.eq(J.getv(offer, "kind"), "weapon"))):
		var owned = J.find(self.weapons, func(w): return (J.eq(J.getv(w, "id"), J.getv(offer, "targetId"))))
		if J.truthy((not J.truthy(owned))):
			if J.truthy((not J.truthy(_addWeapon(J.getv(offer, "targetId"))))):
				return false
		else:
			owned["level"] = J.num(J.getv(owned, "level")) + 1
			for line in J.or_value(J.getv(offer, "upgradeLines"), func(): return []):
				var v = (J.num(finite(J.coalesce(J.getv(line, "value"), func(): return J.getv(line, "modification")))) * J.num(J.or_value(J.getv(offer, "factor"), func(): return 1.0)))
				var field = J.getv({"DamageMultiplier": "damageBonus", "Projectiles": "quantityBonus", "SizeMultiplier": "sizeBonus", "CritChance": "critBonus", "CritDamage": "critDamageBonus", "KnockbackMultiplier": "knockbackBonus", "ProjectileBounces": "bounceBonus"}, J.getv(line, "stat"))
				if J.truthy(field):
					owned[field] = J.add(J.getv(owned, field), v)
				var definition = J.getv(WEAPONS, J.getv(owned, "id"))
				var operation = J.coalesce(J.getv(line, "modifyType"), func(): return J.getv(line, "modify_type"))
				if J.truthy((J.eq(J.getv(line, "stat"), "DurationMultiplier"))):
					owned["durationBonus"] = J.add(J.getv(owned, "durationBonus"), ((J.num(v) / J.num(max(J.num(0.1), J.num(J.or_value(J.getv(definition, "duration"), func(): return 1.0))))) if J.truthy((J.eq(operation, "Flat"))) else v))
				if J.truthy((J.eq(J.getv(line, "stat"), "ProjectileSpeedMultiplier"))):
					owned["speedBonus"] = J.add(J.getv(owned, "speedBonus"), ((J.num(v) / J.num(max(J.num(0.1), J.num(J.or_value(J.getv(J.getv(definition, "sourceStats"), "projectileSpeed"), func(): return 1.0))))) if J.truthy((J.eq(operation, "Flat"))) else v))
	else:
		if J.truthy((J.eq(J.getv(offer, "kind"), "tome"))):
			var tome = J.getv(TOMES, J.getv(offer, "targetId"))
			if J.truthy(J.or_value((not J.truthy(tome)), func(): return J.and_value((not J.truthy(J.getv(self.tomes, J.getv(tome, "id")))), func(): return J.compare(J.length(self.tomes.keys()), self.maxTomeSlots, ">=")))):
				return false
			self.tomes[J.getv(tome, "id")] = J.add(J.or_value(J.getv(self.tomes, J.getv(tome, "id")), func(): return 0.0), 1.0)
			self._tomeBonuses[J.getv(tome, "stat")] = J.add(J.or_value(J.getv(self._tomeBonuses, J.getv(tome, "stat")), func(): return 0.0), (J.num(J.getv(tome, "amount")) * J.num(J.or_value(J.getv(offer, "factor"), func(): return 1.0))))
		else:
			if J.truthy((J.eq(J.getv(offer, "kind"), "stat"))):
				if J.truthy(J.or_value(J.or_value(J.or_value((not J.eq(self.phase, "loot")), func(): return (J.eq(self._pendingLoot, null))), func(): return (not J.truthy(J.getv(offer, "stat")))), func(): return (not J.truthy(J.is_finite_value(J.getv(offer, "value")))))):
					return false
				self._shrineBonuses[J.getv(offer, "stat")] = J.add(J.or_value(J.getv(self._shrineBonuses, J.getv(offer, "stat")), func(): return 0.0), J.getv(offer, "value"))
			else:
				if J.truthy((J.eq(J.getv(offer, "kind"), "item"))):
					if J.truthy(J.or_value(J.or_value((not J.eq(self.phase, "loot")), func(): return (J.eq(self._pendingLoot, null))), func(): return (not J.truthy(J.getv(ITEMS, J.getv(offer, "targetId")))))):
						return false
					self.items[J.getv(offer, "targetId")] = J.add(J.or_value(J.getv(self.items, J.getv(offer, "targetId")), func(): return 0.0), 1.0)
					self._pendingLoot = null
				else:
					return false
	_recalculate()
	self._pendingLoot = null
	self.offers = []
	self.phase = "playing"
	_event("toast", {"message": (J.string(J.getv(offer, "label")) + " · 강화 완료")})
	return true

func reroll():
	if J.truthy(J.or_value(J.or_value((not J.eq(self.phase, "levelup")), func(): return J.compare(self.rerolls, 0.0, "<=")), func(): return self._terminal)):
		return false
	self.rerolls = J.num(self.rerolls) - 1
	self.offers = _levelOffers()
	return true

func pause():
	if J.truthy(J.or_value((not J.eq(self.phase, "playing")), func(): return self._terminal)):
		return false
	self._previousPhase = self.phase
	self.phase = "paused"
	return true

func resume():
	if J.truthy(J.or_value((not J.eq(self.phase, "paused")), func(): return self._terminal)):
		return false
	self.phase = self._previousPhase
	self._inputHeld = {"jump": false, "dash": false, "interact": false}
	return true

func _updateEffects(dt):
	for effect in self.effects:
		effect["life"] = (J.num(J.getv(effect, "life")) - J.num(dt))
	self.effects = J.filterv(self.effects, func(effect): return J.compare(J.getv(effect, "life"), 0.0, ">"))

func _finish(won, reason):
	if J.truthy(self._terminal):
		return false
	self._terminal = true
	self.phase = ("won" if J.truthy(won) else "dead")
	self.offers = []
	self.interaction = null
	self.result = {"won": won, "time": self.time, "duration": self.duration, "kills": self.kills, "level": J.getv(self.player, "level"), "damageDealt": J.round_js(self.damageDealt), "gold": J.getv(self.player, "gold"), "characterId": self.characterId, "mapId": self.mapId, "seed": self.seed, "reason": reason, "mode": self.mode, "tier": self.tier, "stageIndex": self.stageIndex, "stageNumber": self.stageNumber, "stageCount": self.stageCount, "stageTime": self.stageTime, "weapons": J.mapv(self.weapons, func(w): return {"id": J.getv(w, "id"), "level": J.getv(w, "level")}), "items": self.items, "tomes": self.tomes}
	_event(("victory" if J.truthy(won) else "death"), {"message": reason, "value": self.kills})
	return true
