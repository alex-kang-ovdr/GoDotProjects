				enemy["frozen"] = max(J.num(J.getv(enemy, "frozen")), J.num((0.15 if J.truthy(J.getv(enemy, "boss")) else (J.num(J.or_value(J.getv(proc, "stun"), func(): return 3.0)) * J.num(J.getv(self.player, "duration"))))))
