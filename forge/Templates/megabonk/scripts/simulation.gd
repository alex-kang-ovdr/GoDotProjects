				var canExecute = J.and_value((not J.truthy(J.getv(attacker, "boss"))), func(): return (not J.eq(J.getv(J.getv(J.getv(ENEMY_TYPES, J.getv(attacker, "type")), "sourceStats"), "canBeExecutedRaw"), false)))
				_damageEnemy(attacker, (J.getv(attacker, "hp") if J.truthy(canExecute) else (J.num(J.getv(attacker, "maxHp")) * J.num(0.02))), {"noCrit": true, "fixedDamage": true, "proc": 0.1, "weaponId": "Shadowstep", "color": "#c8acf8"})
