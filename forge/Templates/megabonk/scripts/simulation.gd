func step(dt, input = {}):
	if J.truthy(J.or_value((not J.eq(self.phase, "playing")), func(): return self._terminal)):
		return
	dt = clamp(finite(dt), 0.0, 0.15)
	if J.truthy((not J.truthy(dt))):
		return
	var actions = {}
	for key in ["jump", "dash", "interact"]:
		actions[key] = J.and_value(J.truthy(J.getv(input, key)), func(): return (not J.truthy(J.getv(self._inputHeld, key))))
		self._inputHeld[key] = J.truthy(J.getv(input, key))
	var move = {"x": clamp(finite(J.getv(input, "x")), (-J.num(1.0)), 1.0), "z": clamp(finite(J.getv(input, "z")), (-J.num(1.0)), 1.0), "slide": J.truthy(J.getv(input, "slide")), "jumpHeld": J.truthy(J.getv(input, "jump"))}
