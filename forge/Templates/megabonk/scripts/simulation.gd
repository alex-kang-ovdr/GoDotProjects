func _procSuccesses(proc, count, coefficient):
	var c = max(J.num(0.0), J.num(coefficient))
	var n = max(J.num(0.0), J.num(count))
	if J.truthy(J.and_value((J.eq(J.getv(proc, "type"), "poison")), func(): return (J.eq(J.getv(proc, "stacking"), "overflow")))):
		var total = (J.num(J.or_value(J.getv(proc, "chance"), func(): return 0.4)) * J.num(n))
		var guaranteed = floor(J.num(total))
		var remainderChance = clamp((J.num((J.num(total) - J.num(guaranteed))) * J.num(c)), 0.0, 1.0)
		return J.add(guaranteed, (1.0 if J.truthy(J.compare(self.rng.next(), remainderChance, "<")) else 0.0))
	var chance = null
	if J.truthy((J.eq(J.getv(proc, "curve"), "saturating"))):
		var x = (J.num(J.or_value(J.getv(proc, "chancePerStack"), func(): return 0.0)) * J.num(n))
		chance = (J.num((J.num(x) / J.num(max(J.num(0.000001), J.num(J.add(x, J.or_value(J.getv(proc, "chanceK"), func(): return 0.0))))))) * J.num(J.coalesce(J.getv(proc, "chanceMax"), func(): return 1.0)))
	else:
		if J.truthy((not J.eq(J.getv(proc, "chancePerExtraStack"), null))):
			chance = J.add(J.or_value(J.getv(proc, "chance"), func(): return 0.0), (J.num(J.getv(proc, "chancePerExtraStack")) * J.num(max(J.num(0.0), J.num((J.num(n) - J.num(1.0)))))))
		else:
			chance = J.or_value(J.getv(proc, "chance"), func(): return 0.0)
	return (1.0 if J.truthy(J.compare(self.rng.next(), clamp((J.num(chance) * J.num(c)), 0.0, 1.0), "<")) else 0.0)

