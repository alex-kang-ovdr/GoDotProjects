								var a = J.add((J.num((J.num(i) / J.num(count))) * J.num(TAU_VALUE)), (J.num(J.getv(owner, "pattern")) * J.num(0.23)))
								_enemyProjectile(J.getv(owner, "x"), J.getv(owner, "z"), sin(J.num(a)), cos(J.num(a)), 8.5, J.getv(t, "damage"), "#e3a0ff")
						_effect("ring", J.getv(owner, "x"), J.getv(owner, "z"), {"radius": 8.0, "color": "#d18eff", "ttl": 0.5})
		t["finished"] = true
	self.telegraphs = J.filterv(self.telegraphs, func(t): return (not J.truthy(J.getv(t, "finished"))))

func _nearest(x, z, range, excluded = null):
	var nearest = null
	var nearestD = (J.num(range) * J.num(range))
	for e in self._hash.nearby(x, z, range):
		if J.truthy(J.or_value(J.getv(e, "dead"), func(): return J.has(excluded, J.getv(e, "id")))):
			continue
		var d = J.add(pow(J.num((J.num(J.getv(e, "x")) - J.num(x))), J.num(2.0)), pow(J.num((J.num(J.getv(e, "z")) - J.num(z))), J.num(2.0)))
		if J.truthy(J.compare(d, nearestD, "<")):
			nearest = e
			nearestD = d
	return nearest

