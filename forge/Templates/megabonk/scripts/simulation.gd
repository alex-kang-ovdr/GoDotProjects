				if J.truthy(J.and_value(J.and_value(J.compare(dist2(self.player, t), pow(J.num(J.add(J.getv(t, "radius"), 0.4)), J.num(2.0)), "<"), func(): return J.compare(_height(self.player), 1.3, "<")), func(): return J.compare(absf(J.num((J.num(J.getv(self.player, "y")) - J.num(J.getv(t, "y"))))), 2.5, "<"))):
