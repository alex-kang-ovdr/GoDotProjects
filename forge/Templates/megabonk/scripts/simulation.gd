	if J.truthy(J.compare(length, 1.0, ">")):
		move["x"] = (J.num(J.getv(move, "x")) / J.num(length))
		move["z"] = (J.num(J.getv(move, "z")) / J.num(length))
	var count = ceil(J.num((J.num(dt) / J.num((J.num(1.0) / J.num(60.0))))))
	if true:
		var i = 0.0
		var _first_1 = true
		while true:
			if not _first_1:
				i = J.num(i) + 1
			_first_1 = false
			if not J.truthy(J.and_value(J.compare(i, count, "<"), func(): return (J.eq(self.phase, "playing")))):
				break
			_tick((J.num(dt) / J.num(count)), move, (actions if J.truthy((J.eq(i, 0.0))) else {}))

func _tick(dt, move, actions):
	self.time = J.add(self.time, dt)
	self.stageTime = J.add(self.stageTime, dt)
	self._procCounts = {}
	_movePlayer(dt, move, actions)
