; Captain Forever - PlayForge 2D Modular Spaceship Single-Player Template
config_version=5

[application]
config/name="Captain Forever"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[physics]
2d/solver/solver_iterations=32

[input]
thrust_forward={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":87)]}
thrust_reverse={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":83)]}
turn_left={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65)]}
turn_right={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":68)]}
strafe_left={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":81)]}
strafe_right={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":69)]}
fire_primary={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32)]}
fire_missile={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":70)]}
fire_grapple={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":71)]}
station={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":69)]}
restart={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":82)]}
overdrive={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":66)]}
quick_attach={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":67)]}
zoom_in={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194321), Object(InputEventKey,"physical_keycode":61)]}
zoom_out={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194322), Object(InputEventKey,"physical_keycode":45)]}

[playforge]
avatar/presentation_mode=1
avatar/portrait_size=Vector2(140, 140)
avatar/portrait_corner=2
