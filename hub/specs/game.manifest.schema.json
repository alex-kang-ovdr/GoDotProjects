{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playhub.example.com/schemas/game.manifest.schema.json",
  "title": "Game manifest contract version 1",
  "description": "JavaScript 웹 게임 플랫폼 P0 내장 게임용 설계 초안. 지원 여부와 파일 존재는 별도 CI 실행 검사로 확인한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "slug", "title", "summary", "instructions", "entry", "version",
    "tags", "controls", "viewport", "capabilities", "save", "seo", "media"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "slug": {
      "$ref": "#/$defs/identifier",
      "description": "표시 URL 식별자. MVP에서는 id와 같게 유지한다. 변경은 redirect와 분석·저장 ID 보존 정책을 거쳐야 한다."
    },
    "title": { "$ref": "#/$defs/localizedTitle" },
    "summary": { "$ref": "#/$defs/localizedSummary" },
    "instructions": {
      "$ref": "#/$defs/localizedBody",
      "description": "필수 게임별 조작법. 한국어·영어 각각 20–4000자. 안전하게 렌더링한 Markdown 또는 일반 텍스트를 SSR 본문·도움말에 사용한다."
    },
    "rules": {
      "$ref": "#/$defs/localizedBody",
      "description": "선택 게임별 규칙·목표·실패 조건. 제공하면 한국어·영어 각각 20–4000자이며 안전 렌더링 규칙을 적용한다."
    },
    "entry": {
      "const": "index.html",
      "description": "게임 폴더 기준 진입 파일. 외부 URL과 저장소 절대 경로를 허용하지 않는다."
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "MVP 표시 버전 major.minor.patch. 불변 런타임 빌드 식별자는 별도의 산출물 해시를 사용한다."
    },
    "publishedOn": {
      "type": "string",
      "format": "date",
      "description": "한국 시간 기준으로 등록 게임을 처음 공개한 날짜. 최초 공개 때 한 번 기록한다."
    },
    "updatedOn": {
      "type": "string",
      "format": "date",
      "description": "한국 시간 기준으로 이 통합판을 반영한 날짜."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["keyboard", "mouse", "touch", "gamepad"] }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "orientation", "resize"],
      "properties": {
        "width": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "orientation": { "enum": ["any", "landscape", "portrait"] },
        "resize": {
          "enum": ["fit", "responsive"],
          "description": "fit은 기준 비율 유지, responsive는 게임이 실제 크기 변경을 처리하는 계약이다."
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webgl", "wasm", "workers", "fullscreen", "pointerLock", "externalNetwork"],
      "properties": {
        "webgl": { "type": "boolean" },
        "wasm": { "type": "boolean" },
        "workers": {
          "const": false,
          "description": "초기 embedded 프로필은 worker-src none이다. Dedicated Worker와 Service Worker 모두 지원하지 않는다."
        },
        "fullscreen": { "type": "boolean" },
        "pointerLock": { "type": "boolean" },
        "externalNetwork": {
          "type": "array",
          "maxItems": 0,
          "description": "P0 게임의 외부 통신은 허용하지 않는다. 향후 승인 allowlist는 별도 정책·스키마 개정 대상이다."
        }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "schemaVersion", "maxSlots"],
      "properties": {
        "enabled": { "type": "boolean" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "maxSlots": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": { "properties": { "maxSlots": { "minimum": 1 } } },
          "else": { "properties": { "maxSlots": { "const": 0 } } }
        }
      ]
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "indexable"],
      "properties": {
        "title": { "$ref": "#/$defs/localizedTitle" },
        "description": { "$ref": "#/$defs/localizedSummary" },
        "indexable": {
          "type": "boolean",
          "description": "색인 의도. enabled·공개 상태·운영 중단 정책이 함께 적용되며 true가 검색 색인을 보장하지 않는다."
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover", "screenshots"],
      "properties": {
        "cover": { "$ref": "#/$defs/relativeAssetPath" },
        "screenshots": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativeAssetPath" }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "localizedTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 1, "maxLength": 100 },
        "en": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "localizedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 10, "maxLength": 600 },
        "en": { "type": "string", "minLength": 10, "maxLength": 600 }
      }
    },
    "localizedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "en": { "type": "string", "minLength": 20, "maxLength": 4000 }
      },
      "description": "문자열 길이는 JSON Schema의 문자 단위다. 스키마가 XSS를 차단하지는 않는다. 렌더러가 HTML을 escape하고 허용된 Markdown·링크 스킴만 처리해야 한다."
    },
    "relativeAssetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+$",
      "description": "게임 폴더 내부의 ASCII 상대 경로. ../·절대 경로·역슬래시·외부 URL·쿼리·fragment는 금지한다. 이 규칙은 한글 표시 제목을 제한하지 않는다."
    }
  },
  "$comment": "길이·개수는 플랫폼 제안값이다. 스키마 통과는 실행·접근성·성능·권리·악성 코드 부재를 증명하지 않는다. 미디어 MIME·파일 존재·조작법·로케일 표시·실제 capabilities는 CI와 QA에서 별도로 검사한다."
}
