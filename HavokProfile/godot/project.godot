; Havok Physics vs Jolt Physics deterministic explosion benchmark (Forge-HavokPhysics)
config_version=5

[application]

config/name="Havok Physics Profile (ISMProfile Explosion)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/resizable=false
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/physics_engine="HavokPhysics"
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=131072

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
limits/global_shader_variables/buffer_size=2097152
lights_and_shadows/directional_shadow/size=4096
