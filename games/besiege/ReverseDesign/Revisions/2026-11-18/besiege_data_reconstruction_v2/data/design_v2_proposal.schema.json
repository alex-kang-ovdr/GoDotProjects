{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IRONWOOD proposed design V2 (planning artifact; V4 runtime does not load this)",
  "description": "독립 구현 제안. JSON 구조 검사와 별도로 참조 무결성·쿼터니언 norm·catalog/port 호환 검사가 필요하다.",
  "type": "object",
  "properties": {
    "format": {
      "const": "ironwood-design"
    },
    "version": {
      "const": 2
    },
    "status": {
      "const": "proposal"
    },
    "kind": {
      "enum": [
        "assembly",
        "module"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "catalogId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "catalogRevision": {
          "type": "integer",
          "minimum": 1
        },
        "physicsId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "physicsRevision": {
          "type": "integer",
          "minimum": 1
        },
        "controlPolicy": {
          "enum": [
            "legacy_assisted",
            "assisted",
            "physical"
          ]
        },
        "objectivePolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "catalogId",
        "catalogRevision",
        "physicsId",
        "physicsRevision",
        "controlPolicy",
        "objectivePolicy"
      ],
      "additionalProperties": false
    },
    "coordinateFrame": {
      "const": "ironwood_build_y_up_forward_minus_z"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "typeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "orientation": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "boolean",
                "string"
              ]
            }
          }
        },
        "required": [
          "id",
          "typeId",
          "position",
          "orientation",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "kind": {
            "enum": [
              "fixed",
              "hinge",
              "wheel",
              "piston",
              "brace",
              "slider",
              "suspension"
            ]
          },
          "a": {
            "type": "object",
            "properties": {
              "partId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "portId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "localAnchor": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "partId",
              "portId",
              "localAnchor"
            ],
            "additionalProperties": false
          },
          "b": {
            "type": "object",
            "properties": {
              "partId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "\\S"
              },
              "portId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "localAnchor": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "partId",
              "portId",
              "localAnchor"
            ],
            "additionalProperties": false
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "required": [
          "id",
          "kind",
          "a",
          "b",
          "profileId"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "valueType": {
            "enum": [
              "boolean",
              "axis"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "valueType"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "actionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "partId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "portId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "mode": {
            "enum": [
              "hold",
              "press",
              "toggle",
              "axis"
            ]
          },
          "scale": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "actionId",
          "partId",
          "portId",
          "mode",
          "scale"
        ],
        "additionalProperties": false
      }
    },
    "missionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "legacy_import",
            "new_design",
            "module_import"
          ]
        },
        "sourceFormat": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceVersion": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceHash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "origin",
        "sourceFormat",
        "sourceVersion",
        "sourceHash"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "moduleInterfaces": {
      "type": "object",
      "properties": {
        "structural": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "target": {
                "type": "object",
                "properties": {
                  "partId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "portId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "localAnchor": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "partId",
                  "portId",
                  "localAnchor"
                ],
                "additionalProperties": false
              },
              "allowedLinks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "fixed",
                    "hinge",
                    "wheel",
                    "piston",
                    "brace",
                    "slider",
                    "suspension"
                  ]
                }
              }
            },
            "required": [
              "id",
              "label",
              "target",
              "allowedLinks"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "id",
              "actionId",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "structural",
        "actions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "status",
    "kind",
    "profile",
    "coordinateFrame",
    "parts",
    "connections",
    "actions",
    "bindings",
    "missionId",
    "provenance",
    "extensions",
    "moduleInterfaces"
  ],
  "additionalProperties": false
}
