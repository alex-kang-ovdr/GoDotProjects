{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:breath-colony:oni-reference-facts:1.0.0",
  "title": "Public ONI reference fact catalog, not an approved runtime ruleset",
  "type": "object",
  "required": ["schema_version", "dataset_version", "meaning", "entities", "facts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "meaning": {"type": "string", "minLength": 1},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "domain", "label", "raw_file", "raw_id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "raw_file": {"type": "string", "minLength": 1},
          "raw_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["fact_id", "entity_id", "domain", "field", "value", "unit", "evidence_status", "raw_evidence_status", "source_ids", "source_urls", "scope", "observed_at", "source_game_build", "runtime_approved", "notes", "raw_file", "raw_path"],
      "additionalProperties": false,
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean", "object", "array", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "evidence_status": {
          "enum": ["official_patch", "community_reference", "community_display_rounded", "community_reference_uncertain", "derived", "legacy_reference", "unresolved", "not_applicable"]
        },
        "raw_evidence_status": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[RFC][0-9]+$"}},
        "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "scope": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date"},
        "source_game_build": {"type": ["string", "null"]},
        "runtime_approved": {"type": "boolean"},
        "notes": {"type": "string"},
        "raw_file": {"type": "string", "minLength": 1},
        "raw_path": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"value": {"type": "null"}}, "required": ["value"]},
          "then": {
            "properties": {
              "evidence_status": {"enum": ["unresolved", "not_applicable"]},
              "runtime_approved": {"const": false},
              "notes": {"minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"source_game_build": {"type": "null"}}, "required": ["source_game_build"]},
          "then": {"properties": {"runtime_approved": {"const": false}}}
        }
      ]
    }
  }
}
