{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:breath-colony:current-implementation-audit:1",
  "title": "현재 웹 구현 감사 데이터",
  "description": "원작 복원 데이터가 아닌 현행 소스 코드 관찰값의 포맷. 동일 소스 커밋의 실제 파일 해시 및 코드행을 연결한다.",
  "type": "object",
  "required": ["schema_version", "dataset", "scope", "observed_at", "source_commit", "source_tree_dirty", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset": {"enum": ["current_rules", "current_buildings", "current_materials", "current_objectives"]},
    "scope": {"const": "breath-colony-4.0.0-current-implementation"},
    "observed_at": {"type": "string", "format": "date"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tree_dirty": {"type": "boolean"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["source_id", "file", "line_start", "line_end", "sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^A_"},
        "file": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["id", "evidence_status", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidence_status": {"const": "observed_code"},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "unit": {"type": "string", "minLength": 1},
        "value": {},
        "meaning_ko": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"dataset": {"const": "current_rules"}}},
      "then": {"properties": {"records": {"items": {"required": ["system", "entity", "field", "value", "unit", "meaning_ko", "scope"]}}}}
    }
  ]
}
