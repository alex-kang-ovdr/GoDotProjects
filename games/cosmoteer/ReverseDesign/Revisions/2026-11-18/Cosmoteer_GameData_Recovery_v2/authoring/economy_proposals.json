  "updates": [
    {
      "record_id": "nuclear_missile_factory",
      "field": "value_credits",
      "value": 25000,
      "unit": "credits",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-ECO-01"
      ],
      "rationale": "정식 0.26.2가 30,000→25,000 변경을 명시한다. 기존 null 가격만 복구하고, 구형일 가능성이 있는 construction_resources는 null/conflict 유지. 과거 관측값은 삭제하지 않는다.",
      "raw_label": "cost",
      "version_scope": "0.26.2 released patch; no claim that all other fields are from that build"
    },
    {
      "record_id": "recipe_nuclear_missile_parts",
      "field": "power_per_full_missile",
      "value": 4,
      "unit": "game_power/assembled_missile",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-ECO-01"
      ],
      "rationale": "완성 핵미사일 한 발당 전력. 생산 부품 한 개 또는 초당 전력으로 환산하지 않는다.",
      "raw_label": "power usage per full missile",
      "version_scope": "0.26.2 released patch"
    },
    {
      "record_id": "career_economy_rules",
      "field": "repair_resource_rounding",
      "value": "ceil_to_whole_resource",
      "unit": "rounding_rule",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-ECO-04"
      ],
      "rationale": "0.28.2는 손상 부품 수리에 필요한 자원을 정수 올림으로 계산한다고 명시. 손상량에 대한 함수와 자원별 합산 순서는 미확정으로 유지.",
      "raw_label": "resources needed to repair a damaged part now rounds up",
      "version_scope": "0.28.2 released patch"
    },
    {
      "record_id": "crew_barracks",
      "field": "door_placement_constraint",
      "value": "one_door_at_each_end",
      "unit": "placement_rule",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-ECO-01"
      ],
      "rationale": "3×4 병영 양 끝에 각각 문 하나를 허용한다는 공식 설명. 내부 타일 좌표나 회전별 출입구 ID는 복구하지 않는다.",
      "raw_label": "A single door may be added at each end.",
      "version_scope": "0.26.2 released patch"
    },
    {
      "record_id": "crew_characteristics",
      "field": "maximum_roles_per_ship",
      "value": 50,
      "unit": "crew_roles/ship",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-ECO-05"
      ],
      "rationale": "0.20.25에서 20→50으로 확대. 승무원 수 상한과 역할 프리셋 개수 상한을 구분. 이후 빌드의 전체 rules 검증을 뜻하지 않는다.",
      "raw_label": "maximum number of crew roles",
      "version_scope": "0.20.25 released patch"
    },
    {
      "record_id": "fame_rules",
      "field": "maximum_fame_allows_unlimited_hiring",
      "value": false,
      "unit": "boolean",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-ECO-05"
      ],
      "rationale": "0.20.26에서 명성 10,000 도달 후 무제한 고용이 가능했던 버그를 수정. 각 Crew/Fame 설정별 정확한 상한은 여전히 미확정.",
      "raw_label": "maximum fame (10000) ... hire unlimited crew",
      "version_scope": "0.20.26 released patch"
    },
    {
      "record_id": "crew_characteristics",
      "field": "stranded_crew_count_towards_fame_cap",
      "value": true,
      "unit": "boolean",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-ECO-05"
      ],
      "rationale": "0.20.25의 멀리 고립된 승무원이 명성 상한에서 빠지는 버그 수정에 근거. 비활성 구역의 승무원을 고용 여유로 잘못 계산하지 않는 경계 규칙.",
      "raw_label": "stranded ... count against the fame crew limit",
      "version_scope": "0.20.25 released patch"
    }
  ],
