  "updates": [
    {
      "record_id": "door",
      "field": "allows_crew_passage",
      "value": true,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-DOOR"
      ],
      "rationale": "방실 사이 승무원 통행 기능을 명시한다. 문이 놓이는 실제 셀·변 좌표는 추가하지 않는다.",
      "raw_label": "crew passage between rooms"
    },
    {
      "record_id": "door",
      "field": "allows_fire_spread",
      "value": true,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-DOOR"
      ],
      "rationale": "문을 통한 화재 전파 가능성을 명시한다. 확률·전파 주기·문을 닫는 기능은 이 근거로 정하지 않는다.",
      "raw_label": "fire passes through doors"
    },
    {
      "record_id": "crew_quarters",
      "field": "maximum_doors",
      "value": 2,
      "unit": "door",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-QUARTERS"
      ],
      "rationale": "유효 문 위치 그림의 캡션이 두 위치의 동시 사용을 허용한다고 설명한다. 정확한 좌표는 미복원이며 최대 두 문이라는 관측만 추가한다.",
      "raw_label": "Both can be used simultaneously"
    },
    {
      "record_id": "corridor",
      "field": "is_walled",
      "value": false,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-PART-FIELDS"
      ],
      "rationale": "공식 모딩 문서가 corridor/conveyor를 IsWalled=false 예로 명시한다. 문서 WIP·빌드 미상이며 실제 .rules 검사 결과가 아니다.",
      "raw_label": "IsWalled"
    },
    {
      "record_id": "moving_walkway",
      "field": "is_walled",
      "value": false,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-PART-FIELDS"
      ],
      "rationale": "공식 모딩 문서가 corridor/conveyor를 IsWalled=false 예로 명시한다. 문서 WIP·빌드 미상이며 실제 .rules 검사 결과가 아니다.",
      "raw_label": "IsWalled"
    },
    {
      "record_id": "moving_walkway",
      "field": "pathfinding_can_prefer_return_route_over_reverse",
      "value": true,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-WALKWAY"
      ],
      "rationale": "반대 방향 벨트를 그대로 걷는 대신 별도 반환 경로를 선호할 수 있다는 설명을 보존한다. 특정 경로 탐색 알고리즘이나 최적성은 단정하지 않는다.",
      "raw_label": "return route preference"
    },
    {
      "record_id": "power_capacitor",
      "field": "converts_larger_input_packets_to_single_capacity",
      "value": true,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-CAPACITOR"
      ],
      "rationale": "큰 배터리가 축전기에 들어가면 단위 크기로 변환된다는 동작. battery_size=1을 중복 전사하지 않고 변환 관계만 추가한다.",
      "raw_label": "larger batteries converted to single batteries"
    },
    {
      "record_id": "power_capacitor",
      "field": "explodes_on_destruction",
      "value": false,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-CAPACITOR"
      ],
      "rationale": "normal 레코드에 한정한다. 원자로와 다른 비폭발성 저장 동작을 명시하며 오버클럭 모드에 자동 상속하지 않는다.",
      "raw_label": "does not explode upon destruction"
    },
    {
      "record_id": "power_capacitor",
      "field": "outbound_power_requires_crew_delivery",
      "value": true,
      "unit": "boolean",
      "status": "wiki_snapshot",
      "source_ids": [
        "V2-SUP-CAPACITOR"
      ],
      "rationale": "축전기의 전력이 주변 장치로 자동 순간 전달된다는 오해를 막는다.",
      "raw_label": "crew delivery to nearby parts"
    },
    {
      "record_id": "coil_factory",
      "field": "doors_allowed_beside_all_storage_tiles",
      "value": true,
      "unit": "boolean",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-SUP-0290"
      ],
      "rationale": "개발자 0.29.0 변경 내역에 확인되는 관계 규칙이다. 당시 패치 확인값이며 최신 설치 빌드의 개별 문 포트 좌표를 복원한 것은 아니다.",
      "raw_label": "doors next to all storage tiles"
    },
    {
      "record_id": "hyper_coil_factory",
      "field": "doors_allowed_beside_all_storage_tiles",
      "value": true,
      "unit": "boolean",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-SUP-0290"
      ],
      "rationale": "개발자 0.29.0 변경 내역에 확인되는 관계 규칙이다. 당시 패치 확인값이며 최신 설치 빌드의 개별 문 포트 좌표를 복원한 것은 아니다.",
      "raw_label": "doors next to all storage tiles"
    },
    {
      "record_id": "processor_fabricator",
      "field": "doors_allowed_beside_all_storage_tiles",
      "value": true,
      "unit": "boolean",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-SUP-0290"
      ],
      "rationale": "개발자 0.29.0 변경 내역에 확인되는 관계 규칙이다. 당시 패치 확인값이며 최신 설치 빌드의 개별 문 포트 좌표를 복원한 것은 아니다.",
      "raw_label": "doors next to all storage tiles"
    },
    {
      "record_id": "sensor_array",
      "field": "default_operate_priority",
      "value": 9,
      "unit": "priority",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-SUP-0272"
      ],
      "rationale": "0.27.2 개발자 공지의 기본 operate 우선순위. 역할 Hiring Priority와 구분하며 현재 빌드 기본값 유지 여부는 별도 실행 검증 대상이다.",
      "raw_label": "default operate priority"
    },
    {
      "record_id": "sensor_array",
      "field": "default_supply_battery_priority",
      "value": 8,
      "unit": "priority",
      "status": "patch_confirmed",
      "source_ids": [
        "V2-SUP-0272"
      ],
      "rationale": "0.27.2 개발자 공지의 기본 supply battery 우선순위. 조작과 보급이 서로 다른 작업임을 보여준다.",
      "raw_label": "default supply battery priority"
    }
  ],
