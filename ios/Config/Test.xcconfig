#include "Base.xcconfig"

PLAYHUB_BUILD_STAGE = test
PLAYHUB_ALLOW_FARM_SELECTOR = YES
PLAYHUB_DEFAULT_HUB_URL = https://qa-farm.playhub.example.com
PRODUCT_BUNDLE_IDENTIFIER = com.playhub.hub-ios.test
INFOPLIST_KEY_CFBundleDisplayName = Play Hub [test]
SWIFT_ACTIVE_COMPILATION_CONDITIONS = PLAYHUB_TEST ALLOW_FARM_SELECTOR
SWIFT_OPTIMIZATION_LEVEL = -Osize
GCC_OPTIMIZATION_LEVEL = s
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
COPY_PHASE_STRIP = YES
STRIP_STYLE = all
