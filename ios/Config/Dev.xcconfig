#include "Base.xcconfig"

PLAYHUB_BUILD_STAGE = dev
PLAYHUB_ALLOW_FARM_SELECTOR = YES
PLAYHUB_DEFAULT_HUB_URL = https:/$()/dev-farm1.playhub.example.com
PRODUCT_BUNDLE_IDENTIFIER = com.playhub.hub-ios.dev
INFOPLIST_KEY_CFBundleDisplayName = Play Hub [dev]
SWIFT_ACTIVE_COMPILATION_CONDITIONS = PLAYHUB_DEV ALLOW_FARM_SELECTOR
SWIFT_OPTIMIZATION_LEVEL = -Osize
GCC_OPTIMIZATION_LEVEL = s
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
COPY_PHASE_STRIP = NO
