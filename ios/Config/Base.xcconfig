// Shared base build settings for Play Hub iOS (Minimal-Footprint Game Runtime Only — Zero Forge)
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.9
ENABLE_BITCODE = NO
DEAD_CODE_STRIPPING = YES
CLANG_CXX_LANGUAGE_STANDARD = gnu++17
CLANG_CXX_LIBRARY = libc++
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = App/Resources/Info.plist
CODE_SIGN_ENTITLEMENTS = App/Resources/PlayHub.entitlements
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
PLAYHUB_ENGINE_VERSION = 4.7.2
PLAYHUB_FORGE_SUPPORTED = NO
PLAYHUB_BUILD_STAGE = debug
PLAYHUB_ALLOW_FARM_SELECTOR = NO
PLAYHUB_DEFAULT_HUB_URL = http://127.0.0.1:18130
PRODUCT_BUNDLE_IDENTIFIER = com.playhub.hub-ios.debug
INFOPLIST_KEY_CFBundleDisplayName = Play Hub
