; BrawlLabs - standalone Godot 4.7.2 arena brawler template
config_version=5

[application]
config/name="BrawlLabs"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
super={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventMouseButton,"button_index":2)]}
gadget={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80),Object(InputEventKey,"physical_keycode":4194305)]}
restart={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[physics]
2d/default_gravity=0.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
